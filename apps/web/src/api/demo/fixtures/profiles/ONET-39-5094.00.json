{
  "code": "ONET-39-5094.00",
  "name": "Chuyên viên chăm sóc da (spa)",
  "nameEn": "Skincare Specialists",
  "group": "Chăm sóc và dịch vụ cá nhân",
  "regionId": "dich_vu",
  "isIt": false,
  "summary": "Chăm sóc da mặt và cơ thể để làm đẹp. Gồm cả chuyên viên triệt lông bằng điện và bằng laser. Mức chuẩn bị: cần chuẩn bị ở mức vừa. Thường cần học nghề, cao đẳng hoặc chứng chỉ chuyên môn.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần giúp đỡ, dạy bảo và chăm sóc người khác, nhưng ít cần tìm tòi, phân tích và giải quyết vấn đề bằng tư duy.",
  "downsides": [
    "Có nguy cơ tiếp xúc với bệnh truyền nhiễm.",
    "Môi trường cạnh tranh cao.",
    "Lặp đi lặp lại cùng một động tác."
  ],
  "workFacts": [
    "Phần lớn thời gian làm trong nhà, có điều hoà.",
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "Làm việc độc lập nhiều hơn làm theo nhóm.",
    "Được tự quyết nhiều trong công việc.",
    "Ít làm việc qua email.",
    "12% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "13% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Cửa hàng, nhà hàng, khách sạn, cơ sở dịch vụ"],
