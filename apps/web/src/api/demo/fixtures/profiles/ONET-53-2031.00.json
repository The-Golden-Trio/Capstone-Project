{
  "code": "ONET-53-2031.00",
  "name": "Tiếp viên",
  "nameEn": "Flight Attendants",
  "group": "Vận tải và bốc dỡ hàng hoá",
  "regionId": "dich_vu",
  "isIt": false,
  "summary": "Giám sát an toàn khoang hành khách. Phục vụ hành khách, hướng dẫn thông tin an toàn, phục vụ đồ ăn, đồ uống và xử lý sự cố khẩn cấp. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc theo quy trình, chính xác với số liệu và giấy tờ. Nghề cũng cần thuyết phục, dẫn dắt người khác và kinh doanh, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Hay phải tiếp xúc với người khó chịu, giận dữ hoặc thiếu lịch sự.",
    "Làm trong môi trường ồn, gây khó chịu hoặc mất tập trung.",
    "Chịu trách nhiệm trực tiếp về sức khoẻ và an toàn của người khác.",
    "Thường xuyên gặp tình huống xung đột với người khác."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Thường ngồi trong xe hoặc cabin máy.",
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "Làm việc theo nhóm là chính.",
    "32% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "45% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Trên xe, tàu, máy bay", "Hiện trường, công trường, ngoài trời"],
