{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "staff",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "nx", "run", "@datn/staff:serve"],
      "port": 4300
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "nx", "run", "@datn/web:serve"],
      "port": 4200
    },
    {
      "name": "web-mock",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_PLAY_API=mock",
        "pnpm",
        "--dir",
        "apps/web",
        "exec",
        "vite",
        "--port",
        "4210",
        "--strictPort"
      ],
      "port": 4210
    }
  ]
}
