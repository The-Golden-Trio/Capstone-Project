{
  "code": "ONET-39-5012.00",
  "name": "Thợ làm tóc",
  "nameEn": "Hairdressers, Hairstylists, and Cosmetologists",
  "group": "Chăm sóc và dịch vụ cá nhân",
  "regionId": "dich_vu",
  "isIt": false,
  "summary": "Làm dịch vụ làm đẹp như cắt, nhuộm, tạo kiểu tóc, xoa bóp và chăm sóc da đầu. Có thể gội đầu, trang điểm, làm tóc giả, tẩy lông và chăm sóc móng, da. Mức chuẩn bị: cần chuẩn bị ở mức vừa. Thường cần học nghề, cao đẳng hoặc chứng chỉ chuyên môn.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần tìm tòi, phân tích và giải quyết vấn đề bằng tư duy.",
  "downsides": [
    "Lặp đi lặp lại cùng một động tác.",
    "Phải đứng trong phần lớn thời gian làm việc.",
    "Hay phải cúi hoặc vặn người."
  ],
  "workFacts": [
    "Phần lớn thời gian làm trong nhà, có điều hoà.",
    "Đứng phần lớn thời gian làm việc.",
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "Được tự quyết nhiều trong công việc.",
    "Ít làm việc qua email.",
    "40% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "7% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Cửa hàng, nhà hàng, khách sạn, cơ sở dịch vụ"],
