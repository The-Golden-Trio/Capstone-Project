@startuml CL-03_ReviewAndPublishing
title CL-03 · NestJS modules — Review and publishing
hide empty members
skinparam classAttributeIconSize 0
left to right direction

package "ReviewModule" <<Rectangle>> {
  class ReviewModule <<module>> {
    imports: AuthModule, LifecycleModule
    controllers: ReviewController, ReviewAssignmentController
    providers: ReviewService, ReviewAssignmentService
    exports: —
  }
  class ReviewController <<controller>> {
    -reviews : ReviewService
    --
    +listMyReviewQueue(user: AuthUser) : ReviewQueueItem[]  «GET /staff/reviews» [DE]
    +openReview(user: AuthUser, reviewId: string) : ReviewView  «GET /staff/reviews/{reviewId}» [DE]
    +decideReview(user: AuthUser, reviewId: string, dto: ReviewDecisionInput) : ScenarioDetail  «POST /staff/reviews/{reviewId}/decision» [DE]
  }
  class ReviewAssignmentController <<controller>> {
    -assignments : ReviewAssignmentService
    --
    +assignReviewer(user: AuthUser, scenarioId: string, dto: AssignReviewerInput) : ReviewView  «POST /staff/scenarios/{scenarioId}/reviews» [CA]
    +listOverdueReviews(user: AuthUser) : ReviewQueueItem[]  «GET /staff/reviews/overdue» [CA]
    +reassignReview(user: AuthUser, reviewId: string, dto: AssignReviewerInput) : ReviewView  «POST /staff/reviews/{reviewId}/reassign» [CA]
  }
  class ReviewService {
    <i>scenario_review; criteria come from occupation.profile.reviewCriteria</i>
    -prisma : PrismaService
    -lifecycle : ScenarioStateMachine
    -access : AccessPolicyService
    -notifications : NotificationService
    --
    +queue(user) : ReviewQueueItem[]
    +open(user, reviewId) : ReviewView  «SUBMITTED → IN_REVIEW»
    +decide(user, reviewId, dto) : ScenarioDetail  «422 if a criterion is unanswered»
  }
  class ReviewAssignmentService {
    -prisma : PrismaService
    -access : AccessPolicyService
    -notifications : NotificationService
    --
    +assign(user, scenarioId, dto) : ReviewView  «reviewer ≠ author»
    +overdue(user) : ReviewQueueItem[]
    +reassign(user, reviewId, dto) : ReviewView  «old row → REASSIGNED»
  }
  class "ReviewModule DTOs" as ReviewModule_DTOs <<dto>> {
    AssignReviewerInput { reviewerId, deadlineAt }
    ReviewDecisionInput { decision, answers[], comment? }
    ReviewQueueItem
    ReviewView
    ScenarioDetail
  }
}

package "PublishingModule" <<Rectangle>> {
  class PublishingModule <<module>> {
    imports: AuthModule, LifecycleModule, PlayModule
    controllers: BuildController, ReleaseController
    providers: BuildService, BuildSnapshotter, ReleaseService, ReleaseScheduler
    exports: —
  }
  class BuildController <<controller>> {
    -builds : BuildService
    --
    +buildDraftGame(user: AuthUser, scenarioId: string) : Build  «POST /staff/scenarios/{scenarioId}/builds» [CA]
    +getBuild(user: AuthUser, buildId: string) : Build  «GET /staff/builds/{buildId}» [CA,DE]
    +startPlaytestRun(user: AuthUser, buildId: string) : RunView  «POST /staff/builds/{buildId}/runs» [DE]
    +reportFindings(user: AuthUser, buildId: string, dto: FindingsInput) : ScenarioDetail  «POST /staff/builds/{buildId}/findings» [DE]
    +passPlaytest(user: AuthUser, buildId: string) : ScenarioDetail  «POST /staff/builds/{buildId}/pass» [DE]
  }
  class ReleaseController <<controller>> {
    -releases : ReleaseService
    --
    +publishScenario(user: AuthUser, scenarioId: string, dto: PublishInput) : Build  «POST /staff/scenarios/{scenarioId}/release» [CA]
    +deleteScenario(user: AuthUser, scenarioId: string) : ScenarioDetail  «DELETE /staff/scenarios/{scenarioId}» [CA]
  }
  class BuildService {
    -prisma : PrismaService
    -lifecycle : ScenarioStateMachine
    -snapshots : BuildSnapshotter
    -runs : RunService
    -notifications : NotificationService
    --
    +build(user, scenarioId) : Build  «APPROVED → IN_PLAYTEST»
    +get(id) : Build
    +startPlaytest(user, buildId) : RunView
    +reportFindings(user, buildId, dto) : ScenarioDetail  «findings in audit_log; → DRAFT»
    +pass(user, buildId) : ScenarioDetail  «→ READY»
  }
  class BuildSnapshotter {
    -prisma : PrismaService
    --
    +snapshot(tx, scenarioId) : BuildContent  «seed + level package»
    +hash(content) : string
  }
  class ReleaseService {
    -prisma : PrismaService
    -lifecycle : ScenarioStateMachine
    -storage : StorageService
    --
    +publish(user, scenarioId, dto) : Build  «READY only; sets effective_from»
    +delete(user, scenarioId) : ScenarioDetail  «→ RETIRED, sets retired_at»
    +publishDue(now) : number
  }
  class ReleaseScheduler <<cron>> {
    -releases : ReleaseService
    --
    +publishDueReleases() : Promise<void>  «@Cron every 5 min»
  }
  class "PublishingModule DTOs" as PublishingModule_DTOs <<dto>> {
    FindingsInput { runId, findings[] {kind, text} }
    PublishInput { effectiveFrom }
    Build
    RunView
    ScenarioDetail
  }
}

class AccessPolicyService <<CL-01 · AuthModule>>
class RunService <<CL-05 · PlayModule>>
class ScenarioStateMachine <<CL-02 · LifecycleModule>>

ReviewController --> ReviewService
ReviewAssignmentController --> ReviewAssignmentService
ReviewService --> ScenarioStateMachine
ReviewService --> AccessPolicyService
ReviewAssignmentService --> AccessPolicyService
BuildController --> BuildService
ReleaseController --> ReleaseService
BuildService --> ScenarioStateMachine
BuildService --> BuildSnapshotter
BuildService --> RunService
ReleaseService --> ScenarioStateMachine
ReleaseScheduler --> ReleaseService
@enduml
