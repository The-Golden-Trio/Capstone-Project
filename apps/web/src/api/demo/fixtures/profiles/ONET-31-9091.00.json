{
  "code": "ONET-31-9091.00",
  "name": "Trợ thủ nha khoa",
  "nameEn": "Dental Assistants",
  "group": "Hỗ trợ y tế",
  "regionId": "suc_khoe",
  "isIt": false,
  "summary": "Làm một số việc lâm sàng giới hạn dưới sự chỉ đạo của nha sĩ, như chuẩn bị và tiệt trùng dụng cụ, chuẩn bị người bệnh, hỗ trợ nha sĩ trong khi điều trị và hướng dẫn người bệnh chăm sóc răng miệng. Có thể làm việc hành chính như đặt lịch hẹn, lưu hồ sơ, lập hoá đơn và mã hoá thông tin bảo hiểm. Mức chuẩn bị: cần chuẩn bị ở mức vừa. Thường cần học nghề, cao đẳng hoặc chứng chỉ chuyên môn.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Có tiếp xúc với bức xạ.",
    "Có nguy cơ tiếp xúc với bệnh truyền nhiễm.",
    "Hay phải cúi hoặc vặn người.",
    "Lặp đi lặp lại cùng một động tác."
  ],
  "workFacts": [
    "Phần lớn thời gian làm trong nhà, có điều hoà.",
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "Ít được tự quyết, làm theo chỉ đạo và quy trình.",
    "Ít làm việc qua email.",
    "2% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "Gần như ai trong nghề cũng làm giờ cố định."
  ],
  "settings": ["Bệnh viện, phòng khám, cơ sở chăm sóc"],
