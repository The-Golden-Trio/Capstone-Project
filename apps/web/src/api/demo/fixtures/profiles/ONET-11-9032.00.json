  "education": {
    "preparation": "Cần chuẩn bị rất nhiều",
    "note": "Thường cần bằng sau đại học, như thạc sĩ, tiến sĩ hoặc bằng chuyên ngành y, luật. Theo O*NET (Mỹ).",
    "university": ["Quản lý giáo dục", "Giáo dục học"],
