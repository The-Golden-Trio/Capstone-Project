{
  "code": "DATA_DA",
  "name": "Chuyên viên phân tích dữ liệu",
  "nameEn": "Data Analyst",
  "group": "Công nghệ thông tin",
  "regionId": "cong_nghe",
  "isIt": true,
  "summary": "Chuyên viên phân tích dữ liệu trả lời câu hỏi kinh doanh bằng số liệu: lấy dữ liệu bằng SQL, làm sạch, phân tích, dựng dashboard trên công cụ như Power BI hay Tableau, và trình bày kết luận cho các phòng ban. Nghề dùng ít mã hơn các nghề kỹ thuật khác nhưng cần giao tiếp và hiểu nghiệp vụ. Ngân hàng và công ty sản phẩm tuyển nhiều.",
  "fitSummary": "Hợp với người thích làm việc theo quy trình, chính xác với số liệu và giấy tờ. Nghề cũng cần tìm tòi, phân tích và giải quyết vấn đề bằng tư duy, nhưng ít cần làm việc bằng tay với máy móc, công cụ, vật thật.",
  "downsides": [
    "Có lúc bị kỳ vọng dùng số liệu để chứng minh điều cấp trên đã tin sẵn.",
    "Nhiều thời gian dành cho dữ liệu bẩn, thiếu, hoặc mỗi phòng ban đưa một con số khác nhau.",
    "Dashboard làm công phu vẫn có thể không ai dùng.",
    "Trong khảo sát của ITviec, môi trường nhiều chính trị nội bộ là lý do nghỉ việc hay gặp nhất."
  ],
  "workFacts": [
    "Ngồi phần lớn thời gian làm việc.",
    "Ít tiếp xúc với khách hàng bên ngoài.",
    "33% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "9% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
