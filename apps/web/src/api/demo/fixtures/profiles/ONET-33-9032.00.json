{
  "code": "ONET-33-9032.00",
  "name": "Nhân viên bảo vệ, an ninh",
  "nameEn": "Security Guards",
  "group": "Dịch vụ bảo vệ an ninh và an toàn",
  "regionId": "dich_vu",
  "isIt": false,
  "summary": "Canh gác, tuần tra hoặc giám sát khu vực để ngăn trộm cắp, bạo lực hoặc vi phạm nội quy. Có thể vận hành máy soi chiếu và máy dò kim loại. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc theo quy trình, chính xác với số liệu và giấy tờ. Nghề cũng cần làm việc bằng tay với máy móc, công cụ, vật thật, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Thường xuyên gặp tình huống xung đột với người khác.",
    "Hay phải tiếp xúc với người khó chịu, giận dữ hoặc thiếu lịch sự.",
    "Chịu trách nhiệm trực tiếp về sức khoẻ và an toàn của người khác."
  ],
  "workFacts": [
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "24% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "19% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Cửa hàng, nhà hàng, khách sạn, cơ sở dịch vụ"],
  "environments": [
    {
      "name": "Công ty dịch vụ vệ sinh, bảo vệ",
      "weight": 70
    },
    {
      "name": "Ban quản lý toà nhà, chung cư, khu đô thị",
      "weight": 30
    }
  ],
