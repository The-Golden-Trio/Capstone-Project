{
  "code": "ONET-29-2011.00",
  "name": "Kỹ thuật viên xét nghiệm",
  "nameEn": "Medical and Clinical Laboratory Technologists",
  "group": "Y tế chuyên môn và kỹ thuật y tế",
  "regionId": "suc_khoe",
  "isIt": false,
  "summary": "Thực hiện các xét nghiệm y học phức tạp phục vụ chẩn đoán, điều trị và phòng bệnh. Có thể đào tạo hoặc giám sát nhân viên. Mức chuẩn bị: cần chuẩn bị nhiều. Thường cần bằng đại học.",
  "fitSummary": "Hợp với người thích tìm tòi, phân tích và giải quyết vấn đề bằng tư duy. Nghề cũng cần làm việc bằng tay với máy móc, công cụ, vật thật, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Có nguy cơ tiếp xúc với bệnh truyền nhiễm.",
    "Sai sót có thể gây hậu quả nghiêm trọng.",
    "Làm trong điều kiện nguy hiểm như điện cao thế, chất dễ cháy nổ hoặc hoá chất độc.",
    "Công việc lặp lại nhiều."
  ],
  "workFacts": [
    "Phần lớn thời gian làm trong nhà, có điều hoà.",
    "Ít tiếp xúc với khách hàng bên ngoài.",
    "20% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "8% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Bệnh viện, phòng khám, cơ sở chăm sóc"],
