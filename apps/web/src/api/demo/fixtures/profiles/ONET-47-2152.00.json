{
  "code": "ONET-47-2152.00",
  "name": "Thợ ống nước, đường ống",
  "nameEn": "Plumbers, Pipefitters, and Steamfitters",
  "group": "Xây dựng và khai khoáng",
  "regionId": "ky_thuat",
  "isIt": false,
  "summary": "Lắp ráp, lắp đặt, sửa đổi và sửa chữa đường ống, hệ thống ống dẫn nước, hơi, khí nén hoặc chất lỏng, khí khác. Có thể lắp thiết bị sưởi, làm mát và hệ thống điều khiển cơ khí. Gồm cả thợ lắp hệ thống phun nước chữa cháy. Mức chuẩn bị: cần chuẩn bị ở mức vừa. Thường cần học nghề, cao đẳng hoặc chứng chỉ chuyên môn.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Phải leo thang, giàn giáo hoặc cột.",
    "Làm trong không gian chật hoặc tư thế khó.",
    "Hay phải quỳ, cúi, khom hoặc bò.",
    "Phải mặc đồ bảo hộ chuyên dụng như mặt nạ thở, đai an toàn hoặc đồ chống bức xạ."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Thường ngồi trong xe hoặc cabin máy.",
    "Đứng phần lớn thời gian làm việc.",
    "Ít làm việc qua email.",
    "39% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "36% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Hiện trường, công trường, ngoài trời"],
