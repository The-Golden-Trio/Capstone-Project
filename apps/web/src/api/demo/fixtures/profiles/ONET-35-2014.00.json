{
  "code": "ONET-35-2014.00",
  "name": "Đầu bếp",
  "nameEn": "Cooks, Restaurant",
  "group": "Chế biến và phục vụ ăn uống",
  "regionId": "dich_vu",
  "isIt": false,
  "summary": "Chế biến, nêm nếm và nấu các món như súp, thịt, rau hoặc tráng miệng ở nhà hàng. Có thể đặt hàng nguyên liệu, giữ sổ sách, định giá món hoặc lên thực đơn. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần tìm tòi, phân tích và giải quyết vấn đề bằng tư duy.",
  "downsides": [
    "Phải đứng trong phần lớn thời gian làm việc.",
    "Dễ bị bỏng nhẹ, đứt tay, bị cắn hoặc đốt.",
    "Phải đi lại hoặc chạy nhiều."
  ],
  "workFacts": [
    "Phần lớn thời gian làm trong nhà, có điều hoà.",
    "Đứng phần lớn thời gian làm việc.",
    "Ít tiếp xúc với khách hàng bên ngoài.",
    "Làm việc độc lập nhiều hơn làm theo nhóm.",
    "Ít được tự quyết, làm theo chỉ đạo và quy trình.",
    "Ít làm việc qua email.",
    "24% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "22% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Cửa hàng, nhà hàng, khách sạn, cơ sở dịch vụ"],
