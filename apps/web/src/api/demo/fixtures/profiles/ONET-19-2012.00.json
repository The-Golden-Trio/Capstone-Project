{
  "code": "ONET-19-2012.00",
  "name": "Nhà vật lý",
  "nameEn": "Physicists",
  "group": "Khoa học tự nhiên và xã hội",
  "regionId": "cong_nghe",
  "isIt": false,
  "summary": "Nghiên cứu các hiện tượng vật lý, xây dựng lý thuyết dựa trên quan sát và thí nghiệm, và tìm cách ứng dụng các định luật, lý thuyết vật lý. Mức chuẩn bị: cần chuẩn bị rất nhiều. Thường cần bằng sau đại học, như thạc sĩ, tiến sĩ hoặc bằng chuyên ngành y, luật.",
  "fitSummary": "Hợp với người thích tìm tòi, phân tích và giải quyết vấn đề bằng tư duy. Nghề cũng cần làm việc bằng tay với máy móc, công cụ, vật thật, nhưng ít cần thuyết phục, dẫn dắt người khác và kinh doanh.",
  "downsides": [
    "Nhiều người trong nghề làm hơn 40 giờ mỗi tuần.",
    "Có tiếp xúc với bức xạ.",
    "Phải mặc đồ bảo hộ chuyên dụng như mặt nạ thở, đai an toàn hoặc đồ chống bức xạ."
  ],
  "workFacts": [
    "Phần lớn thời gian làm trong nhà, có điều hoà.",
    "Ít tiếp xúc với khách hàng bên ngoài.",
    "65% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "28% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Phòng thí nghiệm"],
