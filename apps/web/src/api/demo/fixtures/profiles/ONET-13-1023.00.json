{
  "code": "ONET-13-1023.00",
  "name": "Chuyên viên mua hàng",
  "nameEn": "Purchasing Agents, Except Wholesale, Retail, and Farm Products",
  "group": "Kinh doanh và tài chính",
  "regionId": "kinh_doanh",
  "isIt": false,
  "summary": "Mua máy móc, thiết bị, dụng cụ, phụ tùng, vật tư hoặc dịch vụ cần cho hoạt động của cơ sở. Mua nguyên liệu thô hoặc bán thành phẩm cho sản xuất. Có thể đàm phán hợp đồng. Mức chuẩn bị: cần chuẩn bị nhiều. Thường cần bằng đại học.",
  "fitSummary": "Hợp với người thích làm việc theo quy trình, chính xác với số liệu và giấy tờ. Nghề cũng cần thuyết phục, dẫn dắt người khác và kinh doanh, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Công việc lặp lại nhiều.",
    "Ngồi gần như cả ngày.",
    "Nhiều việc phải chính xác tuyệt đối; một sai sót nhỏ về số liệu hay quy định có thể gây hậu quả lớn."
  ],
  "workFacts": [
    "Ngồi phần lớn thời gian làm việc.",
    "47% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "7% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Văn phòng"],
