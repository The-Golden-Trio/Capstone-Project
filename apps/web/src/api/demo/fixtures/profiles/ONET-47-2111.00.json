{
  "code": "ONET-47-2111.00",
  "name": "Thợ điện công trình",
  "nameEn": "Electricians",
  "group": "Xây dựng và khai khoáng",
  "regionId": "ky_thuat",
  "isIt": false,
  "summary": "Lắp đặt, bảo trì và sửa chữa dây điện, thiết bị và đồ điện. Bảo đảm làm đúng quy chuẩn. Có thể lắp hoặc bảo dưỡng đèn đường, hệ thống liên lạc nội bộ hoặc hệ thống điều khiển điện. Mức chuẩn bị: cần chuẩn bị ở mức vừa. Thường cần học nghề, cao đẳng hoặc chứng chỉ chuyên môn.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Phải leo thang, giàn giáo hoặc cột.",
    "Phải làm việc trên cao.",
    "Hay phải quỳ, cúi, khom hoặc bò.",
    "Làm trong không gian chật hoặc tư thế khó."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Thường ngồi trong xe hoặc cabin máy.",
    "Đứng phần lớn thời gian làm việc.",
    "Làm việc theo nhóm là chính.",
    "Ít làm việc qua email.",
    "21% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "38% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Hiện trường, công trường, ngoài trời"],
