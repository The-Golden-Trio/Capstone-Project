{
  "code": "ONET-19-3041.00",
  "name": "Nhà nghiên cứu khoa học xã hội",
  "nameEn": "Sociologists",
  "group": "Khoa học tự nhiên và xã hội",
  "regionId": "cong_nghe",
  "isIt": false,
  "summary": "Nghiên cứu xã hội loài người và hành vi xã hội qua các nhóm và thiết chế xã hội mà con người tạo ra, cũng như các tổ chức xã hội, tôn giáo, chính trị và kinh doanh. Có thể nghiên cứu hành vi, tương tác của các nhóm, nguồn gốc, sự phát triển và ảnh hưởng của hoạt động nhóm lên từng thành viên. Mức chuẩn bị: cần chuẩn bị rất nhiều. Thường cần bằng sau đại học, như thạc sĩ, tiến sĩ hoặc bằng chuyên ngành y, luật.",
  "fitSummary": "Hợp với người thích tìm tòi, phân tích và giải quyết vấn đề bằng tư duy. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần thuyết phục, dẫn dắt người khác và kinh doanh.",
  "downsides": [
    "Ngồi gần như cả ngày.",
    "Môi trường cạnh tranh cao.",
    "Kết quả nghiên cứu đến chậm, nhiều thí nghiệm thất bại."
  ],
  "workFacts": [
    "Ngồi phần lớn thời gian làm việc.",
    "Làm việc độc lập nhiều hơn làm theo nhóm.",
    "Được tự quyết nhiều trong công việc.",
    "45% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "24% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Văn phòng"],
