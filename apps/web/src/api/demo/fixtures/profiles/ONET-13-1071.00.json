{
  "code": "ONET-13-1071.00",
  "name": "Chuyên viên nhân sự",
  "nameEn": "Human Resources Specialists",
  "group": "Kinh doanh và tài chính",
  "regionId": "kinh_doanh",
  "isIt": false,
  "summary": "Tuyển dụng, sàng lọc, phỏng vấn hoặc bố trí nhân sự trong tổ chức. Có thể làm nhiều mảng nhân sự khác. Mức chuẩn bị: cần chuẩn bị nhiều. Thường cần bằng đại học.",
  "fitSummary": "Hợp với người thích thuyết phục, dẫn dắt người khác và kinh doanh. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần làm việc bằng tay với máy móc, công cụ, vật thật.",
  "downsides": [
    "Ngồi gần như cả ngày.",
    "Thường xuyên gặp tình huống xung đột với người khác.",
    "Nhiều việc phải chính xác tuyệt đối; một sai sót nhỏ về số liệu hay quy định có thể gây hậu quả lớn."
  ],
  "workFacts": [
    "Ngồi phần lớn thời gian làm việc.",
    "50% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "13% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Văn phòng"],
  "environments": [
