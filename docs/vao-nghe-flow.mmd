%% Vào Nghề — luồng màn hình (bản gọn)
%% Dùng: excalidraw.com → menu "+" → Mermaid to Excalidraw → dán file này
flowchart TD
  subgraph T0["0 · Ngoài cổng"]
    LOGIN["/login<br/>Đăng nhập"]
    REG["/register<br/>Tạo tài khoản"]
  end

  subgraph T1["1 · Cổng"]
    GATE{"RequireAuth<br/>decideGate()"}
    SHELL["AppShell<br/>Topbar + chip Đang ở + XpBar"]
  end

  subgraph T2["2 · Tự vấn"]
    CONSENT["/consent<br/>Người giám hộ đồng ý"]
    QUIZ["/quiz<br/>Get to Know Me · 6 câu"]
    QRES["/quiz/result<br/>StarMap + FitRadar"]
  end

  subgraph T3["3 · Chọn nghề"]
    GALAXY["/jobs<br/>Bản đồ ngân hà 3D<br/>Buồng lái · Dock lân cận · PlanetPanel · EntryTest"]
  end

  subgraph T4["4 · Trong một nghề"]
    SEA["/jobs/:role<br/>Quần đảo + LevelPanel"]
    BAND["/jobs/:role/:band<br/>Bản đồ giấy + QuestBox"]
  end

  subgraph T5["5 · Chơi"]
    PLAY["/play/:key<br/>Màn chơi (chat 2 cột hoặc văn phòng 2D)"]
    END["/play/:key/end<br/>Tổng kết + bằng chứng"]
  end

  subgraph T6["6 · Hồ sơ"]
    PROFILE["/profile<br/>Hành trang"]
    ACC["/account<br/>Tài khoản"]
    ERR["*<br/>Lỗi / không có trang"]
  end

  LOGIN -- "đăng nhập xong" --> GATE
  REG -- "tạo xong" --> GATE
  LOGIN <-. "đổi qua lại" .-> REG
  GATE -- "dưới 16t, chưa đồng ý" --> CONSENT
  GATE -- "chưa làm tự vấn" --> QUIZ
  GATE -- "qua cổng, '/' → /jobs" --> GALAXY
  GATE --> SHELL
  CONSENT -- "ghi nhận xong" --> GATE
  QUIZ -- "hết 6 câu" --> QRES
  QUIZ -. "bỏ qua" .-> GALAXY
  QRES -- "Mở toàn bản đồ" --> GALAXY
  QRES -. "bấm ngôi sao" .-> SEA
  GALAXY -- "Trải nghiệm nghề này" --> SEA
  SEA -- "Vào học chặng này (ghi danh)" --> BAND
  BAND -- "Bắt đầu nhiệm vụ chính" --> PLAY
  BAND -. "nhiệm vụ phụ: hỏi-đáp tại chỗ, +điểm" .-> BAND
  BAND -. "chưa ghi danh → đá về" .-> SEA
  PLAY -- "hết hoạt động" --> END
  END -- "Xem hành trang" --> PROFILE
  END -. "Nhiệm vụ khác" .-> BAND
  END -. "Chơi lại" .-> PLAY
  SHELL -. "huy hiệu" .-> PROFILE
  SHELL -. "chip Đang ở → Tiếp tục" .-> BAND
  PROFILE -. "Làm lại tự vấn" .-> QUIZ
  PROFILE -. "⚙ Tài khoản" .-> ACC
  ACC -- "đăng xuất / đổi mật khẩu" --> LOGIN
  ACC -- "xoá tài khoản" --> REG
  ERR -. "Về tổng quan" .-> GATE
