{
  "code": "ONET-27-4014.00",
  "name": "Kỹ thuật viên âm thanh, ánh sáng, phát sóng",
  "nameEn": "Sound Engineering Technicians",
  "group": "Nghệ thuật, thiết kế, giải trí, thể thao và truyền thông",
  "regionId": "sang_tao",
  "isIt": false,
  "summary": "Lắp ráp và vận hành thiết bị để thu, đồng bộ, trộn, dựng hoặc tái tạo âm thanh, gồm nhạc, giọng nói và hiệu ứng, cho sân khấu, video, phim, truyền hình, podcast, sự kiện thể thao và sản phẩm khác. Mức chuẩn bị: cần chuẩn bị ở mức vừa. Thường cần học nghề, cao đẳng hoặc chứng chỉ chuyên môn.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần giúp đỡ, dạy bảo và chăm sóc người khác.",
  "downsides": [
    "Lịch làm việc không cố định: theo ca, thay đổi hoặc theo mùa.",
    "Ngồi gần như cả ngày.",
    "Công việc lặp lại nhiều."
  ],
  "workFacts": [
    "Phần lớn thời gian làm trong nhà, có điều hoà.",
    "Ngồi phần lớn thời gian làm việc.",
    "Làm việc theo nhóm là chính.",
    "32% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "54% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Phòng thu, sân khấu, trường quay", "Văn phòng"],
