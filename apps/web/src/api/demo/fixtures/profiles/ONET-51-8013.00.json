{
  "code": "ONET-51-8013.00",
  "name": "Vận hành nhà máy điện",
  "nameEn": "Power Plant Operators",
  "group": "Sản xuất",
  "regionId": "ky_thuat",
  "isIt": false,
  "summary": "Điều khiển, vận hành hoặc bảo dưỡng máy móc phát điện. Gồm cả người vận hành thiết bị phụ trợ. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Nhiều người trong nghề làm hơn 40 giờ mỗi tuần.",
    "Sai sót có thể gây hậu quả nghiêm trọng.",
    "Phải làm việc trên cao.",
    "Làm trong điều kiện nguy hiểm như điện cao thế, chất dễ cháy nổ hoặc hoá chất độc."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Ít tiếp xúc với khách hàng bên ngoài.",
    "Làm việc theo nhóm là chính.",
    "57% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "25% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Hiện trường, công trường, ngoài trời"],
