{
  "code": "ONET-31-9092.00",
  "name": "Trợ lý y khoa",
  "nameEn": "Medical Assistants",
  "group": "Hỗ trợ y tế",
  "regionId": "suc_khoe",
  "isIt": false,
  "summary": "Làm việc hành chính và một số việc lâm sàng dưới sự chỉ đạo của bác sĩ. Việc hành chính có thể gồm đặt lịch hẹn, lưu hồ sơ bệnh án, lập hoá đơn và mã hoá thông tin bảo hiểm. Việc lâm sàng có thể gồm đo và ghi dấu hiệu sinh tồn, tiền sử bệnh, chuẩn bị người bệnh để khám, lấy máu và cho dùng thuốc theo chỉ định của bác sĩ. Mức chuẩn bị: cần chuẩn bị ở mức vừa. Thường cần học nghề, cao đẳng hoặc chứng chỉ chuyên môn.",
  "fitSummary": "Hợp với người thích làm việc theo quy trình, chính xác với số liệu và giấy tờ. Nghề cũng cần giúp đỡ, dạy bảo và chăm sóc người khác, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Có nguy cơ tiếp xúc với bệnh truyền nhiễm.",
    "Công việc lặp lại nhiều.",
    "Hay phải tiếp xúc với người khó chịu, giận dữ hoặc thiếu lịch sự."
  ],
  "workFacts": [
    "Phần lớn thời gian làm trong nhà, có điều hoà.",
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "Làm việc theo nhóm là chính.",
    "Ít được tự quyết, làm theo chỉ đạo và quy trình.",
    "9% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "Gần như ai trong nghề cũng làm giờ cố định."
  ],
  "settings": ["Bệnh viện, phòng khám, cơ sở chăm sóc"],
