{
  "code": "ONET-29-1151.00",
  "name": "Kỹ thuật viên gây mê hồi sức",
  "nameEn": "Nurse Anesthetists",
  "group": "Y tế chuyên môn và kỹ thuật y tế",
  "regionId": "suc_khoe",
  "isIt": false,
  "summary": "Gây mê, theo dõi dấu hiệu sinh tồn và giám sát người bệnh hồi tỉnh sau gây mê. Có thể hỗ trợ bác sĩ gây mê, phẫu thuật viên, bác sĩ khác hoặc nha sĩ. Mức chuẩn bị: cần chuẩn bị rất nhiều. Thường cần bằng sau đại học, như thạc sĩ, tiến sĩ hoặc bằng chuyên ngành y, luật.",
  "fitSummary": "Hợp với người thích giúp đỡ, dạy bảo và chăm sóc người khác. Nghề cũng cần tìm tòi, phân tích và giải quyết vấn đề bằng tư duy, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Có tiếp xúc với bức xạ.",
    "Có nguy cơ tiếp xúc với bệnh truyền nhiễm.",
    "Phải mặc đồ bảo hộ chuyên dụng như mặt nạ thở, đai an toàn hoặc đồ chống bức xạ.",
    "Sai sót có thể gây hậu quả nghiêm trọng."
  ],
  "workFacts": [
    "Phần lớn thời gian làm trong nhà, có điều hoà.",
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "Làm việc theo nhóm là chính.",
    "Được tự quyết nhiều trong công việc.",
    "48% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "29% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Bệnh viện, phòng khám, cơ sở chăm sóc"],
  "environments": [
    {
      "name": "Bệnh viện công",
      "weight": 70
    },
    {
      "name": "Bệnh viện tư, quốc tế",
      "weight": 30
    }
  ],
  "education": {
    "preparation": "Cần chuẩn bị rất nhiều",
    "note": "Thường cần bằng sau đại học, như thạc sĩ, tiến sĩ hoặc bằng chuyên ngành y, luật. Theo O*NET (Mỹ).",
    "university": ["Kỹ thuật gây mê hồi sức"],
    "vocational": [],
    "licence": "Giấy phép hành nghề khám bệnh, chữa bệnh (có kỳ kiểm tra đánh giá năng lực) — Luật Khám bệnh, chữa bệnh số 15/2023/QH15, hiệu lực 01/01/2024"
  },
  "levels": [
    {
      "levelNo": 1,
      "band": "L1",
      "bandEquivalent": "L1",
      "title": "Sinh viên gây mê hồi sức thực tập lâm sàng",
      "years": "0",
      "coreOutput": null,
      "tasks": [
        "Kiểm soát đường thở và hô hấp của người bệnh bằng kỹ thuật như đặt nội khí quản, thở máy, thuốc hỗ trợ, trị liệu hô hấp và rút ống.",
        "Xử lý tình huống cấp cứu bằng kiểm soát đường thở, truyền dịch, thuốc cấp cứu hoặc hồi sinh tim phổi cơ bản và nâng cao.",
        "Theo dõi phản ứng của người bệnh như màu da, đồng tử, mạch, nhịp tim, huyết áp, nhịp thở, thông khí hoặc lượng nước tiểu.",
        "Chọn, yêu cầu hoặc cho dùng thuốc mê, thuốc hỗ trợ, dịch truyền hoặc chế phẩm máu khi cần.",
        "Chọn, chuẩn bị hoặc dùng thiết bị, máy theo dõi, vật tư và thuốc cho việc gây mê."
      ],
