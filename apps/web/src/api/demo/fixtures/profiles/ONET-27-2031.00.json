{
  "code": "ONET-27-2031.00",
  "name": "Diễn viên múa",
  "nameEn": "Dancers",
  "group": "Nghệ thuật, thiết kế, giải trí, thể thao và truyền thông",
  "regionId": "sang_tao",
  "isIt": false,
  "summary": "Biểu diễn múa, nhảy. Có thể diễn trên sân khấu, cho phát sóng hoặc ghi hình. Mức chuẩn bị: cần chuẩn bị ở mức vừa. Thường cần học nghề, cao đẳng hoặc chứng chỉ chuyên môn.",
  "fitSummary": "Hợp với người thích sáng tạo và tự do thể hiện ý tưởng. Nghề cũng cần làm việc bằng tay với máy móc, công cụ, vật thật, nhưng ít cần tìm tòi, phân tích và giải quyết vấn đề bằng tư duy.",
  "downsides": [
    "Lịch làm việc không cố định: theo ca, thay đổi hoặc theo mùa.",
    "Hay phải cúi hoặc vặn người.",
    "Môi trường cạnh tranh cao.",
    "Lặp đi lặp lại cùng một động tác."
  ],
  "workFacts": [
    "Phần lớn thời gian làm trong nhà, có điều hoà.",
    "Đứng phần lớn thời gian làm việc.",
    "Làm việc theo nhóm là chính.",
    "Ít được tự quyết, làm theo chỉ đạo và quy trình.",
    "18% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "72% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Phòng thu, sân khấu, trường quay"],
  "environments": [
    {
      "name": "Nhà hát, đoàn nghệ thuật công lập",
      "weight": 60
    },
    {
      "name": "Công ty giải trí, quản lý nghệ sĩ, sự kiện",
      "weight": 40
    }
  ],
  "education": {
