{
  "code": "ONET-43-5071.00",
  "name": "Nhân viên kho và kế hoạch vật tư",
  "nameEn": "Shipping, Receiving, and Inventory Clerks",
  "group": "Văn phòng và hỗ trợ hành chính",
  "regionId": "kinh_doanh",
  "isIt": false,
  "summary": "Kiểm tra và ghi chép hàng nhập, hàng xuất liên quan đến tồn kho. Xác nhận, ghi nhận hàng hoá, vật tư nhập về và thu xếp vận chuyển sản phẩm. Có thể chuẩn bị hàng để gửi đi. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc theo quy trình, chính xác với số liệu và giấy tờ. Nghề cũng cần làm việc bằng tay với máy móc, công cụ, vật thật, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Nhịp làm việc do tốc độ máy móc quyết định.",
    "Thường xuyên phải làm gấp cho kịp hạn.",
    "Công việc lặp lại nhiều."
  ],
  "workFacts": [
    "48% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "7% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Nhà máy, xưởng, kho bãi"],
  "environments": [
    {
      "name": "Kho vận, trung tâm phân loại hàng",
