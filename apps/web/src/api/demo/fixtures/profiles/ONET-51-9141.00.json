{
  "code": "ONET-51-9141.00",
  "name": "Kỹ thuật viên sản xuất bán dẫn",
  "nameEn": "Semiconductor Processing Technicians",
  "group": "Sản xuất",
  "regionId": "ky_thuat",
  "isIt": false,
  "summary": "Làm một hoặc nhiều công đoạn trong sản xuất linh kiện bán dẫn: nạp vật liệu bán dẫn vào lò; cưa thỏi thành đoạn; nạp đoạn vào buồng nuôi tinh thể và theo dõi; xác định trục tinh thể bằng máy X-quang và cưa thỏi thành tấm wafer; làm sạch, đánh bóng và nạp wafer vào các lò, bể hoá chất và thiết bị dùng để tạo mạch và thay đổi tính dẫn điện. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Làm trong điều kiện nguy hiểm như điện cao thế, chất dễ cháy nổ hoặc hoá chất độc.",
    "Thường xuyên phải làm gấp cho kịp hạn.",
    "Lặp đi lặp lại cùng một động tác.",
    "Nhịp làm việc do tốc độ máy móc quyết định."
  ],
  "workFacts": [
    "Phần lớn thời gian làm trong nhà, có điều hoà.",
    "Ít tiếp xúc với khách hàng bên ngoài.",
    "Ít được tự quyết, làm theo chỉ đạo và quy trình.",
    "22% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "Gần như ai trong nghề cũng làm giờ cố định."
  ],
  "settings": ["Nhà máy, xưởng, kho bãi"],
  "environments": [
    {
      "name": "Nhà máy công nghệ cao, phòng sạch",
      "weight": 100
    }
