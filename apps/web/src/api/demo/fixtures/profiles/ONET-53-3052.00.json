{
  "code": "ONET-53-3052.00",
  "name": "Tài xế xe khách, xe buýt",
  "nameEn": "Bus Drivers, Transit and Intercity",
  "group": "Vận tải và bốc dỡ hàng hoá",
  "regionId": "dich_vu",
  "isIt": false,
  "summary": "Lái xe buýt hoặc xe khách, gồm chạy tuyến cố định, xe hợp đồng và xe riêng. Có thể giúp hành khách mang hành lý. Có thể thu tiền vé. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Làm ngoài trời, chịu mọi điều kiện thời tiết.",
    "Có nguy cơ tiếp xúc với bệnh truyền nhiễm.",
    "Sai sót có thể gây hậu quả nghiêm trọng.",
    "Làm trong môi trường ồn, gây khó chịu hoặc mất tập trung."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Thường ngồi trong xe hoặc cabin máy.",
    "Ngồi phần lớn thời gian làm việc.",
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "Làm việc độc lập nhiều hơn làm theo nhóm.",
    "Ít làm việc qua email.",
    "39% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "17% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Trên xe, tàu, máy bay", "Hiện trường, công trường, ngoài trời"],
