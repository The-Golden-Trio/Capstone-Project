{
  "code": "ONET-29-1021.00",
  "name": "Bác sĩ răng hàm mặt (nha sĩ)",
  "nameEn": "Dentists, General",
  "group": "Y tế chuyên môn và kỹ thuật y tế",
  "regionId": "suc_khoe",
  "isIt": false,
  "summary": "Khám, chẩn đoán và điều trị bệnh, chấn thương và dị tật của răng và nướu. Có thể điều trị bệnh của tuỷ và các mô răng ảnh hưởng tới vệ sinh và độ bền của răng. Có thể lắp khí cụ nha khoa hoặc chăm sóc dự phòng. Mức chuẩn bị: cần chuẩn bị rất nhiều. Thường cần bằng sau đại học, như thạc sĩ, tiến sĩ hoặc bằng chuyên ngành y, luật.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần tìm tòi, phân tích và giải quyết vấn đề bằng tư duy, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Có tiếp xúc với bức xạ.",
    "Có nguy cơ tiếp xúc với bệnh truyền nhiễm.",
    "Chịu trách nhiệm trực tiếp về sức khoẻ và an toàn của người khác.",
    "Hay phải cúi hoặc vặn người."
  ],
  "workFacts": [
    "Phần lớn thời gian làm trong nhà, có điều hoà.",
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "Làm việc theo nhóm là chính.",
    "Được tự quyết nhiều trong công việc.",
    "25% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "11% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Bệnh viện, phòng khám, cơ sở chăm sóc"],
