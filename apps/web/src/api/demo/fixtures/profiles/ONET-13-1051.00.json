{
  "code": "ONET-13-1051.00",
  "name": "Kỹ sư dự toán (QS)",
  "nameEn": "Cost Estimators",
  "group": "Kinh doanh và tài chính",
  "regionId": "kinh_doanh",
  "isIt": false,
  "summary": "Lập dự toán chi phí cho sản xuất sản phẩm, dự án xây dựng hoặc dịch vụ để ban quản lý dự thầu hoặc định giá. Có thể chuyên một loại dịch vụ hoặc sản phẩm. Mức chuẩn bị: cần chuẩn bị nhiều. Thường cần bằng đại học.",
  "fitSummary": "Hợp với người thích làm việc theo quy trình, chính xác với số liệu và giấy tờ. Nghề cũng cần thuyết phục, dẫn dắt người khác và kinh doanh, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Ngồi gần như cả ngày.",
    "Nhiều việc phải chính xác tuyệt đối; một sai sót nhỏ về số liệu hay quy định có thể gây hậu quả lớn.",
    "Áp lực cao vào các kỳ chốt sổ, quyết toán hoặc hạn nộp báo cáo."
  ],
  "workFacts": [
    "Ngồi phần lớn thời gian làm việc.",
    "Ít tiếp xúc với khách hàng bên ngoài.",
    "45% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "36% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Văn phòng"],
  "environments": [
    {
      "name": "Công ty tư vấn thiết kế, giám sát",
      "weight": 50
    },
    {
      "name": "Công trường của nhà thầu xây dựng",
      "weight": 30
    },
    {
      "name": "Chủ đầu tư, ban quản lý dự án",
      "weight": 20
