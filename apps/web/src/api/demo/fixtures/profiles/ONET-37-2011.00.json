{
  "code": "ONET-37-2011.00",
  "name": "Nhân viên vệ sinh và buồng phòng",
  "nameEn": "Janitors and Cleaners, Except Maids and Housekeeping Cleaners",
  "group": "Vệ sinh và bảo dưỡng toà nhà, cảnh quan",
  "regionId": "dich_vu",
  "isIt": false,
  "summary": "Giữ cho toà nhà sạch sẽ, gọn gàng. Làm các việc vệ sinh nặng như lau sàn, giặt thảm, lau tường và kính, dọn rác. Có thể trông lò sưởi và nồi hơi, bảo trì thường xuyên, báo quản lý khi cần sửa chữa, và dọn tuyết hoặc rác trên vỉa hè. Mức chuẩn bị: cần chuẩn bị ở mức vừa. Thường cần học nghề, cao đẳng hoặc chứng chỉ chuyên môn.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần tìm tòi, phân tích và giải quyết vấn đề bằng tư duy.",
  "downsides": [
    "Phải đi lại hoặc chạy nhiều.",
    "Hay phải cúi hoặc vặn người.",
    "Phải đứng trong phần lớn thời gian làm việc."
  ],
  "workFacts": [
    "Đứng phần lớn thời gian làm việc.",
    "Ít tiếp xúc với khách hàng bên ngoài.",
    "Làm việc độc lập nhiều hơn làm theo nhóm.",
    "Ít được tự quyết, làm theo chỉ đạo và quy trình.",
    "Ít làm việc qua email.",
    "15% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "14% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Cửa hàng, nhà hàng, khách sạn, cơ sở dịch vụ"],
