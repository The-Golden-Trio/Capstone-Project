{
  "code": "ONET-49-9051.00",
  "name": "Công nhân đường dây và trạm điện",
  "nameEn": "Electrical Power-Line Installers and Repairers",
  "group": "Lắp đặt, bảo trì và sửa chữa",
  "regionId": "ky_thuat",
  "isIt": false,
  "summary": "Lắp đặt hoặc sửa chữa cáp, dây dẫn của hệ thống truyền tải, phân phối điện. Có thể dựng cột và tháp truyền tải nhẹ hoặc nặng. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Phải làm việc trên cao.",
    "Làm trong điều kiện nguy hiểm như điện cao thế, chất dễ cháy nổ hoặc hoá chất độc.",
    "Phải mặc đồ bảo hộ chuyên dụng như mặt nạ thở, đai an toàn hoặc đồ chống bức xạ.",
    "Lịch làm việc không cố định: theo ca, thay đổi hoặc theo mùa."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Thường ngồi trong xe hoặc cabin máy.",
    "Đứng phần lớn thời gian làm việc.",
    "Làm việc theo nhóm là chính.",
    "44% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "50% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Hiện trường, công trường, ngoài trời"],
