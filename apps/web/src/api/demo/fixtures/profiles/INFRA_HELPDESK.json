{
  "code": "INFRA_HELPDESK",
  "name": "Nhân viên hỗ trợ kỹ thuật / IT Support",
  "nameEn": "IT Helpdesk",
  "group": "Công nghệ thông tin",
  "regionId": "cong_nghe",
  "isIt": true,
  "summary": "Nhân viên hỗ trợ kỹ thuật giúp nhân viên trong công ty dùng được máy tính, phần mềm, máy in, mạng và tài khoản: nhận yêu cầu, xử lý sự cố, cài đặt thiết bị, quản lý tài sản IT. Đây là cửa vào ngành dễ tiếp cận nhất, không đòi bằng CNTT; nhiều người dùng vị trí này làm bước đệm sang quản trị hệ thống hoặc an ninh mạng.",
  "fitSummary": "Hợp với người thích làm việc theo quy trình, chính xác với số liệu và giấy tờ. Nghề cũng cần làm việc bằng tay với máy móc, công cụ, vật thật, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Nhiều câu hỏi lặp đi lặp lại hằng ngày.",
    "Có thể bị gọi ngoài giờ, và ở một số nơi phải làm theo ca.",
    "Trần nghề thấp: sau vài năm thường phải chuyển hướng để thăng tiến tiếp.",
    "Lương trung vị thấp nhất trong 22 nghề; các việc đơn giản nhất có thể bị tự động hoá, dù mức độ chưa rõ."
  ],
  "workFacts": [
    "Phần lớn thời gian làm trong nhà, có điều hoà.",
    "Ngồi phần lớn thời gian làm việc.",
    "Ít tiếp xúc với khách hàng bên ngoài.",
    "Được tự quyết nhiều trong công việc.",
    "58% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "Gần như ai trong nghề cũng làm giờ cố định."
  ],
