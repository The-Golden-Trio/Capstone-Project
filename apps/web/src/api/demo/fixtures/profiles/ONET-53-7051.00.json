{
  "code": "ONET-53-7051.00",
  "name": "Người vận hành xe nâng, cần cẩu",
  "nameEn": "Industrial Truck and Tractor Operators",
  "group": "Vận tải và bốc dỡ hàng hoá",
  "regionId": "dich_vu",
  "isIt": false,
  "summary": "Vận hành xe nâng, xe kéo công nghiệp để chuyển vật liệu trong kho, bãi, nhà máy, công trường hoặc nơi tương tự. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Nhiều người trong nghề làm hơn 40 giờ mỗi tuần.",
    "Phải làm việc trên cao.",
    "Nhịp làm việc do tốc độ máy móc quyết định.",
    "Tiếp xúc với nhiệt độ rất nóng hoặc rất lạnh."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Thường ngồi trong xe hoặc cabin máy.",
    "Ít làm việc qua email.",
    "71% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "44% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
