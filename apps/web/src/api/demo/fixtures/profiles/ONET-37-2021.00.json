{
  "code": "ONET-37-2021.00",
  "name": "Nhân viên kiểm soát côn trùng",
  "nameEn": "Pest Control Workers",
  "group": "Vệ sinh và bảo dưỡng toà nhà, cảnh quan",
  "regionId": "dich_vu",
  "isIt": false,
  "summary": "Phun hoặc thả dung dịch hoá chất, khí độc và đặt bẫy để tiêu diệt hoặc loại bỏ côn trùng, chuột và sinh vật gây hại trong nhà và khu vực xung quanh. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Làm trong không gian chật hoặc tư thế khó.",
    "Làm ngoài trời, chịu mọi điều kiện thời tiết.",
    "Phải đi lại hoặc chạy nhiều.",
    "Dễ bị bỏng nhẹ, đứt tay, bị cắn hoặc đốt."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Thường ngồi trong xe hoặc cabin máy.",
    "Đứng phần lớn thời gian làm việc.",
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "Làm việc độc lập nhiều hơn làm theo nhóm.",
    "Được tự quyết nhiều trong công việc.",
    "Ít làm việc qua email.",
    "45% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "46% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Hiện trường, công trường, ngoài trời"],
