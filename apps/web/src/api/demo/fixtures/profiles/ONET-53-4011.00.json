{
  "code": "ONET-53-4011.00",
  "name": "Lái tàu hoả, tàu điện",
  "nameEn": "Locomotive Engineers",
  "group": "Vận tải và bốc dỡ hàng hoá",
  "regionId": "dich_vu",
  "isIt": false,
  "summary": "Lái đầu máy điện, diesel-điện, hơi nước hoặc tua-bin khí để chở khách hoặc hàng. Hiểu lệnh chạy tàu, tín hiệu điện tử hoặc thủ công và quy định đường sắt. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Nhiều người trong nghề làm hơn 40 giờ mỗi tuần.",
    "Sai sót có thể gây hậu quả nghiêm trọng.",
    "Làm ngoài trời, chịu mọi điều kiện thời tiết.",
    "Làm trong môi trường ồn, gây khó chịu hoặc mất tập trung."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Thường ngồi trong xe hoặc cabin máy.",
    "Làm việc theo nhóm là chính.",
    "Ít được tự quyết, làm theo chỉ đạo và quy trình.",
    "Ít làm việc qua email.",
    "56% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "47% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Trên xe, tàu, máy bay", "Hiện trường, công trường, ngoài trời"],
