{
  "code": "ONET-41-2031.00",
  "name": "Nhân viên bán hàng",
  "nameEn": "Retail Salespersons",
  "group": "Bán hàng",
  "regionId": "kinh_doanh",
  "isIt": false,
  "summary": "Bán hàng như đồ nội thất, xe cộ, thiết bị gia dụng hoặc quần áo cho người tiêu dùng. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích thuyết phục, dẫn dắt người khác và kinh doanh. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần tìm tòi, phân tích và giải quyết vấn đề bằng tư duy.",
  "downsides": [
    "Hay phải tiếp xúc với người khó chịu, giận dữ hoặc thiếu lịch sự.",
    "Phải đứng trong phần lớn thời gian làm việc.",
    "Thường xuyên gặp tình huống xung đột với người khác."
  ],
  "workFacts": [
    "Đứng phần lớn thời gian làm việc.",
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "33% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "29% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Cửa hàng, nhà hàng, khách sạn, cơ sở dịch vụ"],
