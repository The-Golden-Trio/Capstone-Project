@startuml ERD-02_OccupationCatalogueAndProfile
title ERD-02 · Occupation catalogue and profile
hide circle

entity "domain" as domain {
  * id : uuid <<PK>>
  --
  * code : varchar(40) <<UQ>>
  * name : varchar(120)
  * created_by : uuid <<FK>>
  * created_at : timestamp
}

entity "occupation" as occupation {
  * id : uuid <<PK>>
  --
  * domain_id : uuid <<FK>>
  * code : varchar(40) <<UQ>>
  * name : varchar(120)
    summary : text
    riasec_code : varchar(3)
  * status : occupation_status
  * created_by : uuid <<FK>>
  * created_at : timestamp
    published_at : timestamp
    retired_at : timestamp
  .. + D-115, D-125 (ERD-09) ..
    interest_region_id : uuid <<FK>>
    onet_soc_codes : varchar(10)[]
    difficulty_k : numeric(3,2)
    difficulty_class : difficulty_class
}

entity "occupation_level" as occupation_level {
  * id : uuid <<PK>>
  --
  * occupation_id : uuid <<FK>>
  * level_no : smallint
  * band : varchar(3)
  * title : varchar(120)
  * description : text
    future_role : text
  * credit_threshold : integer
    salary_min : numeric(12,0)
    salary_max : numeric(12,0)
    salary_currency : char(3)
    written_by : uuid <<FK>>
  * updated_at : timestamp
  .. + D-114, D-117, D-119, D-133 ..
    band_equivalent : varchar(3)
    evidence_grade : char(1)
    point_budget : integer
    unlock_ratio : numeric(3,2)
    main_mission_count : smallint
    salary_ref_vnd : numeric(12,0)
    xu_per_mission : smallint
}

entity "downside" as downside {
  * id : uuid <<PK>>
  --
  * occupation_id : uuid <<FK>>
  * text : text
  * sort_order : smallint
  * written_by : uuid <<FK>>
}

entity "generation_rule" as generation_rule {
  * id : uuid <<PK>>
  --
  * occupation_id : uuid <<FK>>
  * rule_text : text
  * written_by : uuid <<FK>>
  * created_at : timestamp
}

entity "competency" as competency {
  * id : uuid <<PK>>
  --
  * code : varchar(60) <<UQ>>
  * kind : competency_kind
  * name : varchar(160)
  * indicator : text
    source_record_id : uuid <<FK>>
  * created_by : uuid <<FK>>
  .. + D-116 (ERD-08) ..
    soft_skill_item_id : uuid <<FK>>
}

entity "level_competency" as level_competency {
  * level_id : uuid <<PK,FK>>
  * competency_id : uuid <<PK,FK>>
  --
  * proficiency : proficiency
}

entity "occupation_adjacency" as occupation_adjacency {
  * from_occupation_id : uuid <<PK,FK>>
  * to_occupation_id : uuid <<PK,FK>>
  --
  * overlap : numeric(4,3)
  * max_start_level_no : smallint
  * is_visible : boolean
  * computed_at : timestamp
}

entity "task" as task {
  * id : uuid <<PK>>
  --
  * level_id : uuid <<FK>>
    source_record_id : uuid <<FK>>
  * text : text
  * sort_order : smallint
}

entity "import_job" as import_job {
  * id : uuid <<PK>>
  --
    occupation_id : uuid <<FK>>
  * source : reference_source
  * file_key : varchar(255)
  * requested_by : uuid <<FK>>
  * status : job_status
  * unresolved_count : integer
  * requested_at : timestamp
    finished_at : timestamp
    completed_by : uuid <<FK>>
    completed_at : timestamp
}

entity "reference_record" as reference_record {
  * id : uuid <<PK>>
  --
  * import_job_id : uuid <<FK>>
  * kind : reference_kind
  * source_code : varchar(255)
  * payload : jsonb
  * is_resolved : boolean
  * is_skipped : boolean
    adjusted_by : uuid <<FK>>
    adjusted_at : timestamp
}

entity "interest_region\n(ERD-09)" as interest_region
entity "soft_skill_item\n(ERD-08)" as soft_skill_item

occupation }o--|| domain
occupation }o--o| interest_region
competency }o--o| soft_skill_item
occupation_level }o--|| occupation
downside }o--|| occupation
generation_rule }o--|| occupation
competency }o--o| reference_record
level_competency }o--|| occupation_level
level_competency }o--|| competency
occupation_adjacency }o--|| occupation : from_occupation_id
occupation_adjacency }o--|| occupation : to_occupation_id
task }o--|| occupation_level
task }o--o| reference_record
import_job }o--o| occupation
reference_record }o--|| import_job

note bottom of occupation_adjacency
  Kept as a per-pair cache; jumping is computed
  per player from explorer_keyword (D-124, ERD-09).
  Open: 07 A27.
end note
@enduml
