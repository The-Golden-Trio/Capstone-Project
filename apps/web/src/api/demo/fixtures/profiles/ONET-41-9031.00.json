{
  "code": "ONET-41-9031.00",
  "name": "Kỹ sư kinh doanh (sales kỹ thuật)",
  "nameEn": "Sales Engineers",
  "group": "Bán hàng",
  "regionId": "kinh_doanh",
  "isIt": false,
  "summary": "Bán hàng hoá hoặc dịch vụ cho doanh nghiệp, loại hàng đòi nền kỹ thuật tương đương bằng kỹ sư. Mức chuẩn bị: cần chuẩn bị nhiều. Thường cần bằng đại học.",
  "fitSummary": "Hợp với người thích thuyết phục, dẫn dắt người khác và kinh doanh. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Nhiều người trong nghề làm hơn 40 giờ mỗi tuần.",
    "Môi trường cạnh tranh cao.",
    "Thường xuyên gặp tình huống xung đột với người khác."
  ],
  "workFacts": [
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "Được tự quyết nhiều trong công việc.",
    "67% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "22% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Văn phòng"],
  "environments": [
    {
      "name": "Nhà cung cấp, bảo trì thiết bị",
      "weight": 55
    },
    {
      "name": "Văn phòng công ty nước ngoài, đa quốc gia",
      "weight": 45
    }
  ],
  "education": {
    "preparation": "Cần chuẩn bị nhiều",
    "note": "Thường cần bằng đại học. Theo O*NET (Mỹ).",
