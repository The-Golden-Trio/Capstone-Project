{
  "code": "ONET-49-9041.00",
  "name": "Thợ bảo trì máy công nghiệp",
  "nameEn": "Industrial Machinery Mechanics",
  "group": "Lắp đặt, bảo trì và sửa chữa",
  "regionId": "ky_thuat",
  "isIt": false,
  "summary": "Sửa chữa, lắp đặt, điều chỉnh hoặc bảo trì máy sản xuất, chế biến công nghiệp hoặc hệ thống phân phối của nhà máy lọc dầu và đường ống. Có thể lắp đặt, tháo dỡ hoặc di chuyển máy và thiết bị nặng theo phương án. Mức chuẩn bị: cần chuẩn bị ở mức vừa. Thường cần học nghề, cao đẳng hoặc chứng chỉ chuyên môn.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Nhiều người trong nghề làm hơn 40 giờ mỗi tuần.",
    "Phải làm việc trên cao.",
    "Làm trong không gian chật hoặc tư thế khó.",
    "Hay phải quỳ, cúi, khom hoặc bò."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Thường ngồi trong xe hoặc cabin máy.",
    "Đứng phần lớn thời gian làm việc.",
    "61% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "38% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Hiện trường, công trường, ngoài trời"],
