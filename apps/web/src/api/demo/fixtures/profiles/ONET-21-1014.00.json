{
  "code": "ONET-21-1014.00",
  "name": "Chuyên viên tư vấn tâm lý",
  "nameEn": "Mental Health Counselors",
  "group": "Cộng đồng và công tác xã hội",
  "regionId": "suc_khoe",
  "isIt": false,
  "summary": "Tư vấn cho cá nhân và nhóm để nâng cao sức khoẻ tâm thần và cảm xúc, chú trọng phòng ngừa. Có thể giúp người gặp nhiều vấn đề như nghiện; khó khăn gia đình, nuôi dạy con, hôn nhân; quản lý căng thẳng; lòng tự trọng hoặc tuổi già. Mức chuẩn bị: cần chuẩn bị rất nhiều. Thường cần bằng sau đại học, như thạc sĩ, tiến sĩ hoặc bằng chuyên ngành y, luật.",
  "fitSummary": "Hợp với người thích giúp đỡ, dạy bảo và chăm sóc người khác. Nghề cũng cần tìm tòi, phân tích và giải quyết vấn đề bằng tư duy, nhưng ít cần làm việc bằng tay với máy móc, công cụ, vật thật.",
  "downsides": [
    "Ngồi gần như cả ngày.",
    "Thường xuyên gặp tình huống xung đột với người khác.",
    "Hay phải tiếp xúc với người khó chịu, giận dữ hoặc thiếu lịch sự."
  ],
  "workFacts": [
    "Phần lớn thời gian làm trong nhà, có điều hoà.",
    "Ngồi phần lớn thời gian làm việc.",
    "Làm việc độc lập nhiều hơn làm theo nhóm.",
    "Được tự quyết nhiều trong công việc.",
    "21% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "18% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Văn phòng"],
  "environments": [
    {
      "name": "Phòng tham vấn, trị liệu tâm lý tư nhân",
      "weight": 60
