{
  "code": "ONET-31-1131.00",
  "name": "Hộ lý, trợ lý điều dưỡng",
  "nameEn": "Nursing Assistants",
  "group": "Hỗ trợ y tế",
  "regionId": "suc_khoe",
  "isIt": false,
  "summary": "Chăm sóc hoặc hỗ trợ chăm sóc cơ bản dưới sự chỉ đạo của điều dưỡng có chứng chỉ tại chỗ. Theo dõi sức khoẻ, cho ăn, tắm rửa, mặc quần áo, chải chuốt, vệ sinh và hỗ trợ đi lại cho người bệnh ở cơ sở y tế hoặc viện dưỡng lão. Có thể cho uống thuốc và làm các việc y tế khác. Mức chuẩn bị: cần chuẩn bị ở mức vừa. Thường cần học nghề, cao đẳng hoặc chứng chỉ chuyên môn.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần giúp đỡ, dạy bảo và chăm sóc người khác, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Có nguy cơ tiếp xúc với bệnh truyền nhiễm.",
    "Phải đi lại hoặc chạy nhiều.",
    "Hay phải tiếp xúc với người khó chịu, giận dữ hoặc thiếu lịch sự.",
    "Hay phải cúi hoặc vặn người."
  ],
  "workFacts": [
    "Đứng phần lớn thời gian làm việc.",
    "Làm việc theo nhóm là chính.",
    "Ít được tự quyết, làm theo chỉ đạo và quy trình.",
    "Ít làm việc qua email.",
    "17% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "15% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Bệnh viện, phòng khám, cơ sở chăm sóc"],
