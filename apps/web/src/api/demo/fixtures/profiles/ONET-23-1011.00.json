{
  "code": "ONET-23-1011.00",
  "name": "Luật sư",
  "nameEn": "Lawyers",
  "group": "Pháp lý",
  "regionId": "kinh_doanh",
  "isIt": false,
  "summary": "Đại diện thân chủ trong các vụ án hình sự, dân sự và các thủ tục pháp lý khác, soạn thảo văn bản pháp lý, hoặc quản lý và tư vấn cho thân chủ về các giao dịch pháp lý. Có thể chuyên một lĩnh vực hoặc hành nghề rộng trong nhiều lĩnh vực luật. Mức chuẩn bị: cần chuẩn bị rất nhiều. Thường cần bằng sau đại học, như thạc sĩ, tiến sĩ hoặc bằng chuyên ngành y, luật.",
  "fitSummary": "Hợp với người thích thuyết phục, dẫn dắt người khác và kinh doanh. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần làm việc bằng tay với máy móc, công cụ, vật thật.",
  "downsides": [
    "Nhiều người trong nghề làm hơn 40 giờ mỗi tuần.",
    "Ngồi gần như cả ngày.",
    "Thường xuyên gặp tình huống xung đột với người khác."
  ],
  "workFacts": [
    "Ngồi phần lớn thời gian làm việc.",
    "Làm việc độc lập nhiều hơn làm theo nhóm.",
    "Được tự quyết nhiều trong công việc.",
    "57% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "32% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Văn phòng"],
  "environments": [
    {
      "name": "Công ty luật, văn phòng luật sư",
      "weight": 75
