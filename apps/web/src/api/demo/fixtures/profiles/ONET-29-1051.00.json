{
  "code": "ONET-29-1051.00",
  "name": "Dược sĩ",
  "nameEn": "Pharmacists",
  "group": "Y tế chuyên môn và kỹ thuật y tế",
  "regionId": "suc_khoe",
  "isIt": false,
  "summary": "Cấp phát thuốc theo đơn của bác sĩ và nhân viên y tế, hướng dẫn người bệnh về thuốc và cách dùng. Có thể tư vấn cho bác sĩ về lựa chọn thuốc, liều dùng, tương tác và tác dụng phụ. Mức chuẩn bị: cần chuẩn bị rất nhiều. Thường cần bằng sau đại học, như thạc sĩ, tiến sĩ hoặc bằng chuyên ngành y, luật.",
  "fitSummary": "Hợp với người thích làm việc theo quy trình, chính xác với số liệu và giấy tờ. Nghề cũng cần giúp đỡ, dạy bảo và chăm sóc người khác, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Hay phải tiếp xúc với người khó chịu, giận dữ hoặc thiếu lịch sự.",
    "Có nguy cơ tiếp xúc với bệnh truyền nhiễm.",
    "Sai sót có thể gây hậu quả nghiêm trọng.",
    "Thường xuyên gặp tình huống xung đột với người khác."
  ],
  "workFacts": [
    "Phần lớn thời gian làm trong nhà, có điều hoà.",
    "Đứng phần lớn thời gian làm việc.",
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "Làm việc theo nhóm là chính.",
    "Ít được tự quyết, làm theo chỉ đạo và quy trình.",
    "18% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "9% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Bệnh viện, phòng khám, cơ sở chăm sóc"],
