{
  "code": "ONET-35-3023.01",
  "name": "Nhân viên pha chế (barista, bartender)",
  "nameEn": "Baristas",
  "group": "Chế biến và phục vụ ăn uống",
  "regionId": "dich_vu",
  "isIt": false,
  "summary": "Pha chế hoặc phục vụ cà phê đặc biệt và các loại đồ uống khác. Phục vụ đồ ăn như bánh nướng hoặc bánh mì kẹp. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần tìm tòi, phân tích và giải quyết vấn đề bằng tư duy.",
  "downsides": [
    "Phải đứng trong phần lớn thời gian làm việc.",
    "Hay phải tiếp xúc với người khó chịu, giận dữ hoặc thiếu lịch sự.",
    "Phải đi lại hoặc chạy nhiều.",
    "Lặp đi lặp lại cùng một động tác."
  ],
  "workFacts": [
    "Đứng phần lớn thời gian làm việc.",
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "Ít làm việc qua email.",
    "1% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "25% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Cửa hàng, nhà hàng, khách sạn, cơ sở dịch vụ"],
