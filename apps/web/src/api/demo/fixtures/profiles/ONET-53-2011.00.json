{
  "code": "ONET-53-2011.00",
  "name": "Phi công",
  "nameEn": "Airline Pilots, Copilots, and Flight Engineers",
  "group": "Vận tải và bốc dỡ hàng hoá",
  "regionId": "dich_vu",
  "isIt": false,
  "summary": "Lái và dẫn đường máy bay cánh cố định, thường trên các tuyến bay thường lệ, để chở khách và hàng. Cần chứng chỉ vận tải hàng không và năng định cho loại máy bay cụ thể. Gồm cả phi công nội địa, quốc tế và giáo viên huấn luyện phi công. Mức chuẩn bị: cần chuẩn bị nhiều. Thường cần bằng đại học.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Lịch làm việc không cố định: theo ca, thay đổi hoặc theo mùa.",
    "Phải làm việc trên cao.",
    "Chịu trách nhiệm trực tiếp về sức khoẻ và an toàn của người khác.",
    "Sai sót có thể gây hậu quả nghiêm trọng."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Thường ngồi trong xe hoặc cabin máy.",
    "Ngồi phần lớn thời gian làm việc.",
    "Làm việc theo nhóm là chính.",
    "Được tự quyết nhiều trong công việc.",
    "50% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "77% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Trên xe, tàu, máy bay", "Hiện trường, công trường, ngoài trời"],
