{
  "code": "ONET-51-5112.00",
  "name": "Công nhân in ấn",
  "nameEn": "Printing Press Operators",
  "group": "Sản xuất",
  "regionId": "ky_thuat",
  "isIt": false,
  "summary": "Cài đặt và vận hành máy in kỹ thuật số, in typo, in offset, in flexo, in ống đồng hoặc máy in khác. Gồm cả máy in offset số lượng nhỏ. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc theo quy trình, chính xác với số liệu và giấy tờ. Nghề cũng cần làm việc bằng tay với máy móc, công cụ, vật thật, nhưng ít cần thuyết phục, dẫn dắt người khác và kinh doanh.",
  "downsides": [
    "Thường xuyên phải làm gấp cho kịp hạn.",
    "Tiếp xúc với khói, bụi, hoá chất, dầu mỡ hoặc mùi khó chịu.",
    "Nhịp làm việc do tốc độ máy móc quyết định."
  ],
  "workFacts": [
    "Phần lớn thời gian làm trong nhà, có điều hoà.",
    "Đứng phần lớn thời gian làm việc.",
    "Ít được tự quyết, làm theo chỉ đạo và quy trình.",
    "Ít làm việc qua email.",
    "19% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "27% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Nhà máy, xưởng, kho bãi"],
  "environments": [
