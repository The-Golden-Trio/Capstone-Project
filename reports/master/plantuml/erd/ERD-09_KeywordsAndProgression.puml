@startuml ERD-09_KeywordsAndProgression
title ERD-09 · Keywords, point budgets and occupation progression
hide circle
' Sources: 02-quyet-dinh D-111, D-114, D-115, D-117..D-125 (section J);
' research/reports/Hồ sơ JobQuest cơ chế game.md (Khối E, G); Gợi ý nghề cách tính.md.
' occupation_adjacency (ERD-02) is kept as-is; per-player jumping vs per-pair table is open (07 A27).

package "Occupation profile (O*NET)" {
entity "interest_region" as interest_region <<D-125>> #DDEBF7 {
  * id : uuid <<PK>>
  --
  * code : varchar(20) <<UQ>>
  * name : varchar(80)
  * sort_order : smallint
}

' ── O*NET profile of an occupation, normalised (D-111, D-114, D-115) ──
entity "occupation_riasec" as occupation_riasec <<D-111>> #DDEBF7 {
  * occupation_id : uuid <<PK,FK>>
  * axis : riasec_type <<PK>>
  --
  * value : numeric(4,2)
}

entity "occupation_skill_need" as occupation_skill_need <<D-114>> #DDEBF7 {
  * occupation_id : uuid <<PK,FK>>
  * group_id : uuid <<PK,FK>>
  --
  * z_need : numeric(4,2)
}

entity "occupation_similarity" as occupation_similarity <<D-111>> #DDEBF7 {
  * from_occupation_id : uuid <<PK,FK>>
  * to_occupation_id : uuid <<PK,FK>>
  --
  * sim : numeric(4,3)
  * computed_at : timestamp
}

entity "occupation_prerequisite" as occupation_prerequisite <<D-121>> #DDEBF7 {
  * occupation_id : uuid <<PK,FK>>
  * required_occupation_id : uuid <<PK,FK>>
  --
  * min_level_no : smallint
}

}

package "ESCO keywords" {
' ── ESCO v1.2.1 keywords (D-120, D-123) ──
entity "esco_occupation" as esco_occupation <<D-120>> #DDEBF7 {
  * id : uuid <<PK>>
  --
  * esco_uri : varchar(255) <<UQ>>
  * name_en : varchar(255)
}

entity "occupation_esco" as occupation_esco <<D-123>> #DDEBF7 {
  * occupation_id : uuid <<PK,FK>>
  * esco_occupation_id : uuid <<PK,FK>>
  --
}

entity "esco_skill_group" as esco_skill_group <<D-120>> #DDEBF7 {
  * id : uuid <<PK>>
  --
  * esco_uri : varchar(255) <<UQ>>
  * name_en : varchar(255)
  * name_vi : varchar(255)
}

entity "keyword" as keyword <<D-120>> #DDEBF7 {
  * id : uuid <<PK>>
  --
  * esco_uri : varchar(255) <<UQ>>
  * skill_group_id : uuid <<FK>>
  * name_vi : varchar(255)
  * name_en : varchar(255)
}

entity "occupation_keyword" as occupation_keyword <<D-120>> #DDEBF7 {
  * occupation_id : uuid <<PK,FK>>
  * keyword_id : uuid <<PK,FK>>
  --
  * kind : keyword_kind
  * max_proficiency : keyword_proficiency
  * is_hand_picked : boolean
    pick_reason : text
}

entity "keyword_transfer" as keyword_transfer <<cần chốt>> #FCE4D6 {
  * from_keyword_id : uuid <<PK,FK>>
  * to_keyword_id : uuid <<PK,FK>>
  --
  * credit : numeric(3,2)
}

}

package "Per level" {
' ── Per-level budget, requirements and keywords (D-114, D-119, D-121) ──
entity "level_keyword" as level_keyword <<D-104>> #DDEBF7 {
  * level_id : uuid <<PK,FK>>
  * keyword_id : uuid <<PK,FK>>
  * direction : keyword_direction <<PK>>
  --
  * proficiency : keyword_proficiency
}

entity "level_skill_budget" as level_skill_budget <<D-114>> #DDEBF7 {
  * level_id : uuid <<PK,FK>>
  * group_id : uuid <<PK,FK>>
  --
  * points : integer
  * is_focus : boolean
}

entity "level_skill_requirement" as level_skill_requirement <<D-114>> #DDEBF7 {
  * level_id : uuid <<PK,FK>>
  * group_id : uuid <<PK,FK>>
  --
  * min_tier : smallint
}

}

package "Player progress" {
' ── Player progress ──
entity "explorer_keyword" as explorer_keyword <<D-124>> #DDEBF7 {
  * explorer_id : uuid <<PK,FK>>
  * keyword_id : uuid <<PK,FK>>
  --
  * proficiency : keyword_proficiency
    source_level_id : uuid <<FK>>
  * achieved_at : timestamp
}

entity "scenario_best" as scenario_best <<D-119>> #DDEBF7 {
  * explorer_id : uuid <<PK,FK>>
  * scenario_id : uuid <<PK,FK>>
  --
  * best_score : smallint
  * best_run_id : uuid <<FK>>
  * completions : smallint
  * updated_at : timestamp
}

}

entity "user_account\n(ERD-01)" as user_account
entity "occupation\n(ERD-02)" as occupation
entity "occupation_level\n(ERD-02)" as occupation_level
entity "scenario\n(ERD-03)" as scenario
entity "scenario_run\n(ERD-05)" as scenario_run
entity "soft_skill_group\n(ERD-08)" as soft_skill_group

occupation }o--|| interest_region
occupation_riasec }o--|| occupation
occupation_skill_need }o--|| occupation
occupation_skill_need }o--|| soft_skill_group
occupation_similarity }o--|| occupation : from_occupation_id
occupation_similarity }o--|| occupation : to_occupation_id
occupation_prerequisite }o--|| occupation : occupation_id
occupation_prerequisite }o--|| occupation : required_occupation_id
occupation_esco }o--|| occupation
occupation_esco }o--|| esco_occupation
keyword }o--|| esco_skill_group
occupation_keyword }o--|| occupation
occupation_keyword }o--|| keyword
keyword_transfer }o--|| keyword : from_keyword_id
keyword_transfer }o--|| keyword : to_keyword_id
level_keyword }o--|| occupation_level
level_keyword }o--|| keyword
level_skill_budget }o--|| occupation_level
level_skill_budget }o--|| soft_skill_group
level_skill_requirement }o--|| occupation_level
level_skill_requirement }o--|| soft_skill_group
explorer_keyword }o--|| user_account
explorer_keyword }o--|| keyword
explorer_keyword }o--o| occupation_level
scenario_best }o--|| user_account
scenario_best }o--|| scenario
scenario_best }o--|| scenario_run

note right of occupation_esco
  ≤ 2 ESCO occupations per occupation (D-123);
  none or too thin → hand-picked keywords
  (occupation_keyword.is_hand_picked + reason).
end note

note bottom of level_skill_budget
  Level budget = band base × 0.746 × k^1.4 (D-114),
  split over 7 groups by O*NET need; 2 focus groups ×1.6.
  Unlock at occupation_level.unlock_ratio (60%) of budget.
end note

note bottom of explorer_keyword
  Jumping uses only keywords the player has reached (D-124):
  coverage ≥ 50% of the target's keywords, 30% when
  Sim ≥ 1.2 (D-122). Credit 1 / 0.5 / 0.25 (D-118).
end note

note bottom of scenario_best
  Replay keeps the best result and adds only the
  difference (D-119). Pay on replay: 100/50/25% (open, K5).
end note

legend right
  |<#DDEBF7>      | new, from a ✅ decision (stereotype = D-ID) |
  |<#FFF2CC>      | new, decided in research/, no D-ID yet |
  |<#FCE4D6>      | new, still "Cần chốt" (07 A28) |
  |<#FFFFFF>      | existing ERD-01..07 table |
endlegend
@enduml
