{
  "code": "ONET-29-1131.00",
  "name": "Bác sĩ thú y",
  "nameEn": "Veterinarians",
  "group": "Y tế chuyên môn và kỹ thuật y tế",
  "regionId": "suc_khoe",
  "isIt": false,
  "summary": "Chẩn đoán, điều trị hoặc nghiên cứu bệnh và chấn thương ở động vật. Gồm cả bác sĩ thú y làm nghiên cứu, kiểm dịch vật nuôi hoặc chăm sóc thú cưng. Mức chuẩn bị: cần chuẩn bị rất nhiều. Thường cần bằng sau đại học, như thạc sĩ, tiến sĩ hoặc bằng chuyên ngành y, luật.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần tìm tòi, phân tích và giải quyết vấn đề bằng tư duy, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Có tiếp xúc với bức xạ.",
    "Phải mặc đồ bảo hộ chuyên dụng như mặt nạ thở, đai an toàn hoặc đồ chống bức xạ.",
    "Có nguy cơ tiếp xúc với bệnh truyền nhiễm.",
    "Dễ bị bỏng nhẹ, đứt tay, bị cắn hoặc đốt."
  ],
  "workFacts": [
    "Phần lớn thời gian làm trong nhà, có điều hoà.",
    "Đứng phần lớn thời gian làm việc.",
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "Làm việc theo nhóm là chính.",
    "24% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "16% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Bệnh viện, phòng khám, cơ sở chăm sóc"],
