{
  "code": "ONET-47-2221.00",
  "name": "Thợ kết cấu thép, nhôm kính",
  "nameEn": "Structural Iron and Steel Workers",
  "group": "Xây dựng và khai khoáng",
  "regionId": "ky_thuat",
  "isIt": false,
  "summary": "Nâng, đặt và liên kết dầm, cột thép và các cấu kiện khác để tạo thành công trình hoặc khung kết cấu. Có thể dựng bồn chứa kim loại và lắp nhà thép tiền chế. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần giúp đỡ, dạy bảo và chăm sóc người khác.",
  "downsides": [
    "Phải làm việc trên cao.",
    "Dễ bị bỏng nhẹ, đứt tay, bị cắn hoặc đốt.",
    "Hay phải quỳ, cúi, khom hoặc bò.",
    "Phải mặc đồ bảo hộ chuyên dụng như mặt nạ thở, đai an toàn hoặc đồ chống bức xạ."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Đứng phần lớn thời gian làm việc.",
    "Ít tiếp xúc với khách hàng bên ngoài.",
    "Ít làm việc qua email.",
    "28% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "35% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Hiện trường, công trường, ngoài trời"],
