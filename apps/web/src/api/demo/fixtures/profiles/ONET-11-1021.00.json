{
  "code": "ONET-11-1021.00",
  "name": "Giám đốc điều hành, quản lý vận hành",
  "nameEn": "General and Operations Managers",
  "group": "Quản lý",
  "regionId": "kinh_doanh",
  "isIt": false,
  "summary": "Lập kế hoạch, điều hành và điều phối hoạt động của tổ chức nhà nước hoặc tư nhân, giám sát nhiều phòng ban hoặc chi nhánh. Xây dựng chính sách, quản lý vận hành hằng ngày và lên kế hoạch sử dụng vật tư, nhân lực; phạm vi rộng, không gói trong một mảng chức năng như nhân sự hay mua hàng. Thường quản lý thông qua các trưởng bộ phận. Mức chuẩn bị: cần chuẩn bị nhiều. Thường cần bằng đại học.",
  "fitSummary": "Hợp với người thích thuyết phục, dẫn dắt người khác và kinh doanh. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Nhiều người trong nghề làm hơn 40 giờ mỗi tuần.",
    "Chịu trách nhiệm trực tiếp về sức khoẻ và an toàn của người khác.",
    "Thường xuyên gặp tình huống xung đột với người khác."
  ],
  "workFacts": [
    "Thường ngồi trong xe hoặc cabin máy.",
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "Làm việc theo nhóm là chính.",
    "Được tự quyết nhiều trong công việc.",
    "70% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "16% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Văn phòng"],
  "environments": [
    {
      "name": "Văn phòng doanh nghiệp vừa và nhỏ trong nước",
      "weight": 50
    },
    {
      "name": "Văn phòng tập đoàn lớn trong nước",
      "weight": 30
    },
    {
      "name": "Văn phòng công ty nước ngoài, đa quốc gia",
      "weight": 20
    }
  ],
  "education": {
    "preparation": "Cần chuẩn bị nhiều",
    "note": "Thường cần bằng đại học. Theo O*NET (Mỹ).",
    "university": ["Quản trị kinh doanh", "Khoa học quản lý", "Kinh tế học"],
