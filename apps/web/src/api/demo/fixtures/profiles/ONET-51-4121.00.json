{
  "code": "ONET-51-4121.00",
  "name": "Thợ hàn",
  "nameEn": "Welders, Cutters, Solderers, and Brazers",
  "group": "Sản xuất",
  "regionId": "ky_thuat",
  "isIt": false,
  "summary": "Dùng thiết bị hàn tay, cắt bằng lửa, hàn thiếc hoặc hàn vảy để hàn, nối chi tiết kim loại hoặc lấp lỗ, vết lõm, đường nối trên sản phẩm kim loại. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần giúp đỡ, dạy bảo và chăm sóc người khác.",
  "downsides": [
    "Dễ bị bỏng nhẹ, đứt tay, bị cắn hoặc đốt.",
    "Làm trong nhà nhưng không có kiểm soát nhiệt độ hay thông gió.",
    "Làm trong môi trường ồn, gây khó chịu hoặc mất tập trung.",
    "Tiếp xúc với khói, bụi, hoá chất, dầu mỡ hoặc mùi khó chịu."
  ],
  "workFacts": [
    "Đứng phần lớn thời gian làm việc.",
    "Ít tiếp xúc với khách hàng bên ngoài.",
    "Ít được tự quyết, làm theo chỉ đạo và quy trình.",
    "Ít làm việc qua email.",
    "49% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "19% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Nhà máy, xưởng, kho bãi"],
