# Chế độ dữ liệu của explorer app:
#   hybrid (mặc định khi dev): phần backend đã có gọi API thật, phần chưa có dùng dữ liệu mẫu
#   live: chỉ gọi API thật
#   demo: chạy hoàn toàn trong trình duyệt (dữ liệu mẫu, AI giả) để xem giao diện
VITE_API_MODE=hybrid
# Client ID của Google Identity Services (đăng nhập Google). Bỏ trống thì ẩn nút.
VITE_GOOGLE_CLIENT_ID=
