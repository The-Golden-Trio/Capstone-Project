{
  "code": "ONET-33-9092.00",
  "name": "Nhân viên cứu hộ bể bơi, bãi biển",
  "nameEn": "Lifeguards, Ski Patrol, and Other Recreational Protective Service Workers",
  "group": "Dịch vụ bảo vệ an ninh và an toàn",
  "regionId": "dich_vu",
  "isIt": false,
  "summary": "Giám sát khu vui chơi giải trí như bể bơi, bãi biển hoặc dốc trượt tuyết để hỗ trợ và bảo vệ người tham gia. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần giúp đỡ, dạy bảo và chăm sóc người khác, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Có nguy cơ tiếp xúc với bệnh truyền nhiễm.",
    "Sai sót có thể gây hậu quả nghiêm trọng.",
    "Tiếp xúc với nhiệt độ rất nóng hoặc rất lạnh.",
    "Chịu trách nhiệm trực tiếp về sức khoẻ và an toàn của người khác."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "Làm việc theo nhóm là chính.",
    "Ít được tự quyết, làm theo chỉ đạo và quy trình.",
    "18% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "22% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Hiện trường, công trường, ngoài trời"],
