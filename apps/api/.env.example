NODE_ENV=
PORT=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=
# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=
# Bi mat ky JWT — sinh bang: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Goc cua web app, dung cho CORS khi chay that (luc dev da co proxy Vite)
WEB_ORIGIN=

# AI cua luong choi ca lam: live | fake. De trong = fake luc dev, live luc production.
# fake dung narrator va bo phan gia (chi de dev/demo), bi cam khi NODE_ENV=production.
AI_MODE=

# --- Model AI (khong bat buoc; thieu key thi AI-4 bao "khong co model") ---
# Kiem tra sau khi dien key: pnpm exec nx run @datn/api:narrator-try -- --mode=check
# Chi can MOT trong hai: QWEN_API_KEY (mua truc tiep) hoac OPENROUTER_API_KEY.
# Alibaba Cloud Model Studio (Qwen) — dan truyen chinh
QWEN_API_KEY=
# Phai khop region tao key. De trong = ap-southeast-1 (Singapore, chi can key, chua co JSON Schema strict)
# ap-southeast-1 | ap-northeast-1 | cn-hongkong | eu-central-1 | us-east-1
QWEN_REGION=
# Bat buoc voi moi region tru Singapore
QWEN_WORKSPACE_ID=
# Dan nguyen "API Host" trong console, ket thuc bang /compatible-mode/v1, neu mac dinh khong chay
QWEN_BASE_URL=
# implicit | explicit
QWEN_CACHE_MODE=
# schema | object. De trong = tu suy theo region
QWEN_JSON_MODE=
# Key goi Token Plan (sk-sp-...): QWEN_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# va AI_ALLOW_UNCONFIRMED_PROVIDERS=true.
# OpenRouter — cung model Qwen, khong can region hay workspace. Ba judge cua AI-5
# (Anthropic, OpenAI, Google) CHI goi qua OpenRouter: thieu key nay thi khong cham duoc cau tu luan.
# Kiem: pnpm exec nx run @datn/api:judge-try -- --mode=live
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
# DeepSeek — du phong
DEEPSEEK_API_KEY=
# true chi khi thu bang du lieu gia: cho goi nha cung cap chua co cam ket khong huan luyen
AI_ALLOW_UNCONFIRMED_PROVIDERS=

# --- Redis: job queue (BullMQ) va luong su kien giua API va worker ---
# De trong = redis://localhost:6379 (brew services start redis, hoac docker compose -f infra/local/dev-stack.yml up -d)
REDIS_URL=

# --- Staff app (CA, DE) ---
# Gốc staff app: CORS và link trong email gửi staff
STAFF_ORIGIN=
# Phiên rảnh quá số phút này thì refresh bị từ chối (NFR-17). Để trống = 120
IDLE_TIMEOUT_MINUTES=
# Số lượt đánh giá nghề tối thiểu trước khi công bố điểm trung bình (NFR-06). Để trống = 5
RATING_MIN_RESPONSES=
# SMTP gửi email thông báo. Dev: mailpit trong infra/local/dev-stack.yml -> smtp://localhost:1025
# Để trống thì chỉ ghi log
SMTP_URL=
MAIL_FROM=
# Kho object cho asset (S3/MinIO). Dev: minio trong infra/local/dev-stack.yml
# S3_ENDPOINT=http://localhost:9000, S3_ACCESS_KEY/S3_SECRET_KEY theo dev-stack.yml
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Chỉ cho script seed-staff (tài khoản dev CA/DE). Không dùng mật khẩu thật.
SEED_STAFF_PASSWORD=
