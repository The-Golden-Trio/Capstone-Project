{
  "code": "ONET-27-3091.00",
  "name": "Phiên dịch, biên dịch viên",
  "nameEn": "Interpreters and Translators",
  "group": "Nghệ thuật, thiết kế, giải trí, thể thao và truyền thông",
  "regionId": "sang_tao",
  "isIt": false,
  "summary": "Phiên dịch lời nói hoặc ngôn ngữ ký hiệu, hoặc biên dịch văn bản từ ngôn ngữ này sang ngôn ngữ khác. Mức chuẩn bị: cần chuẩn bị nhiều. Thường cần bằng đại học.",
  "fitSummary": "Hợp với người thích làm việc theo quy trình, chính xác với số liệu và giấy tờ. Nghề cũng cần sáng tạo và tự do thể hiện ý tưởng, nhưng ít cần làm việc bằng tay với máy móc, công cụ, vật thật.",
  "downsides": [
    "Công việc lặp lại nhiều.",
    "Ngồi gần như cả ngày.",
    "Thường xuyên phải làm gấp cho kịp hạn."
  ],
  "workFacts": [
    "Ngồi phần lớn thời gian làm việc.",
    "Làm việc độc lập nhiều hơn làm theo nhóm.",
    "35% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "35% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Văn phòng"],
