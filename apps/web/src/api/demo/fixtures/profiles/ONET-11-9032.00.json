  "levels": [
    {
      "levelNo": 1,
      "band": "L4",
      "bandEquivalent": "L4",
      "title": "Tổ trưởng chuyên môn",
      "years": "3–6",
      "coreOutput": null,
      "tasks": [
        "Tư vấn và định hướng cho học sinh về vấn đề cá nhân, học tập, nghề nghiệp hoặc hành vi.",
        "Trao đổi với phụ huynh và giáo viên về hoạt động giáo dục, chính sách, hành vi hoặc khó khăn học tập của học sinh.",
        "Dự giờ và xem tài liệu học tập để đánh giá, chuẩn hoá chương trình, phương pháp dạy và tìm chỗ cần cải thiện.",
        "Xác định phạm vi chương trình đào tạo, soạn dự thảo thời khoá biểu và mô tả môn học để ước tính nhu cầu giáo viên, cơ sở vật chất.",
        "Thực thi nội quy về kỷ luật và chuyên cần."
      ],
