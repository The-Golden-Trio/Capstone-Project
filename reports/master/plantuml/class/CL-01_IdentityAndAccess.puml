@startuml CL-01_IdentityAndAccess
hide empty members
skinparam classAttributeIconSize 0
left to right direction

package "AuthModule" <<Rectangle>> {
  class AuthModule <<module>> {
    imports: JwtModule
    controllers: AuthController
    providers: AuthService, TokenService, PasswordService, GoogleOAuthService, AccountStore, AccessPolicyService, JwtAuthGuard, RolesGuard, OccupationAccessGuard
    exports: TokenService, PasswordService, AccountStore, AccessPolicyService, OccupationAccessGuard
  }
  class AuthController <<controller>> {
    -auth : AuthService
    --
    +register(dto: RegisterInput) : Session  «POST /auth/register» [Pub]
    +signIn(dto: SignInInput) : Session  «POST /auth/sign-in» [Pub]
    +signInWithGoogle(dto: GoogleSignInInput) : Session  «POST /auth/google» [Pub]
    +refreshSession(dto: RefreshInput) : Session  «POST /auth/refresh» [Pub]
    +signOut(user: AuthUser) : void  «POST /auth/sign-out» [EX,DE,CA,SA]
    +requestPasswordReset(dto: PasswordResetInput) : void  «POST /auth/password-reset» [Pub]
    +confirmPasswordReset(dto: PasswordResetConfirmInput) : void  «POST /auth/password-reset/confirm» [Pub]
  }
  class AuthService {
    -accounts : AccountStore
    -tokens : TokenService
    -passwords : PasswordService
    -google : GoogleOAuthService
    -audit : AuditLogService
    --
    +register(dto) : Session  «USER_ACCOUNT + EXPLORER in one transaction»
    +signIn(dto) : Session
    +signInWithGoogle(dto) : Session
    +refresh(dto) : Session
    +signOut(user) : void
    +requestPasswordReset(dto) : void
    +confirmPasswordReset(dto) : void
  }
  class TokenService {
    <i>AUTH_SESSION (refresh hash, rotated) and PASSWORD_RESET_TOKEN (single use)</i>
    -jwt : JwtService
    -prisma : PrismaService
    -settings : SettingsService
    --
    +issue(account) : Session
    +verifyAccess(token) : AuthUser
    +rotate(refreshToken) : Session
    +revokeAll(userId) : void
  }
  class PasswordService {
    +hash(plain) : Promise<string>
    +verify(plain, hash) : Promise<boolean>
  }
  class GoogleOAuthService {
    -oauth : OAuth2Client
    --
    +exchangeCode(code, redirectUri) : GoogleProfile
  }
  class AccountStore {
    <i>the only writer of the identity tables; sign-in, profile and admin screens all go through it</i>
    -prisma : PrismaService
    --
    +findByEmail(email) : Account | null
    +createExplorer(tx, data) : Account  «USER_ACCOUNT + EXPLORER (subclass, same id)»
    +createStaff(tx, data) : Account  «USER_ACCOUNT + STAFF_MEMBER»
    +linkIdentity(tx, userId, provider, subject) : void
    +update(tx, userId, patch) : Account
    +softDelete(tx, userId) : void  «status DELETED, deletedAt, personal data cleared»
  }
  class AccessPolicyService {
    <i>reads ASSIGNED_TO, SCENARIO.author, REVIEW_ASSIGNMENT</i>
    -prisma : PrismaService
    --
    +occupationOf(ref) : Promise<string>
    +isAssigned(userId, occupationId, role?) : boolean
    +isAuthorOf(userId, scenarioId) : boolean
    +isReviewerOf(userId, scenarioId) : boolean
  }
  class JwtAuthGuard <<guard>> {
    -tokens : TokenService
    -reflector : Reflector
    --
    +canActivate(ctx) : boolean
  }
  class RolesGuard <<guard>> {
    -reflector : Reflector
    --
    +canActivate(ctx) : boolean
  }
  class OccupationAccessGuard <<guard>> {
    <i>on every /staff route</i>
    -access : AccessPolicyService
    --
    +canActivate(ctx) : Promise<boolean>
  }
  class Decorators <<decorator>> {
    @Public()
    @Roles(...roles)
    @CurrentUser() : AuthUser
  }
  class "AuthModule DTOs" as AuthModule_DTOs <<dto>> {
    GoogleSignInInput { code, redirectUri, birthDate? }
    PasswordResetConfirmInput { token, newPassword }
    PasswordResetInput { email }
    RefreshInput { refreshToken }
    RegisterInput { email, password, nickname, birthDate }
    SignInInput { email, password }
    Session
  }
}

package "UserModule" <<Rectangle>> {
  class UserModule <<module>> {
    imports: AuthModule
    controllers: MeController, UserAdminController, StaffingController
    providers: AccountService, UserAdminService, StaffingService
    exports: —
  }
  class MeController <<controller>> {
    -accounts : AccountService
    --
    +getMe(user: AuthUser) : Me  «GET /me» [EX,DE,CA,SA]
    +updateMe(user: AuthUser, dto: UpdateMeInput) : Me  «PATCH /me» [EX,DE,CA,SA]
    +deleteMe(user: AuthUser) : void  «DELETE /me» [EX]
  }
  class UserAdminController <<controller>> {
    -users : UserAdminService
    --
    +listUsers(user: AuthUser, query: ListQuery) : Page<UserAdminView>  «GET /admin/users» [SA]
    +createStaffAccount(user: AuthUser, dto: CreateStaffInput) : UserAdminView  «POST /admin/users» [SA]
    +updateUser(user: AuthUser, userId: string, dto: UpdateUserInput) : UserAdminView  «PATCH /admin/users/{userId}» [SA]
    +deleteUser(user: AuthUser, userId: string) : void  «DELETE /admin/users/{userId}» [SA]
    +getUserActivity(user: AuthUser, userId: string, query: ListQuery) : Page<AuditEntry>  «GET /admin/users/{userId}/activity» [SA]
  }
  class StaffingController <<controller>> {
    -staffing : StaffingService
    --
    +getOccupationStaff(user: AuthUser, occupationId: string) : OccupationStaff  «GET /admin/occupations/{occupationId}/staff» [SA]
    +setOccupationStaff(user: AuthUser, occupationId: string, dto: StaffingInput) : OccupationStaff  «PUT /admin/occupations/{occupationId}/staff» [SA]
  }
  class AccountService {
    -accounts : AccountStore
    -passwords : PasswordService
    -tokens : TokenService
    --
    +getMe(user) : Me
    +update(user, dto) : Me
    +deleteExplorer(user) : void  «soft delete; the account row stays for the ledger and run history»
  }
  class UserAdminService {
    -accounts : AccountStore
    -tokens : TokenService
    -audit : AuditLogService
    -notifications : NotificationService
    --
    +list(query) : Page<UserAdminView>
    +createStaff(admin, dto) : UserAdminView
    +update(admin, userId, dto) : UserAdminView
    +delete(admin, userId) : void  «staff are anonymised»
    +activity(userId, query) : Page<AuditEntry>
  }
  class StaffingService {
    -prisma : PrismaService
    -notifications : NotificationService
    --
    +get(occupationId) : OccupationStaff
    +set(admin, occupationId, dto) : OccupationStaff  «one active CA, ≥ 1 DE»
  }
  class "UserModule DTOs" as UserModule_DTOs <<dto>> {
    CreateStaffInput { email, displayName, roles[] }
    ListQuery { cursor?, limit?: integer, status?, kind? }
    StaffingInput { contentAdminId, domainExpertIds[] }
    UpdateMeInput { nickname?, currentPassword?, newPassword? }
    UpdateUserInput { status?: ACTIVE|DISABLED, roles?[]: EXPLORER|DOMAIN_EXPERT|CONTENT_ADMIN|SYSTEM_ADMIN }
    AuditEntry
    Me
    OccupationStaff
    UserAdminView
  }
}

class AssignedTo <<domain · CD-01>>
class AuthSession <<domain · CD-01>>
class Explorer <<domain · CD-01>>
class PasswordResetToken <<domain · CD-01>>
class StaffMember <<domain · CD-01>>
class UserAccount <<domain · CD-01>>
class UserIdentity <<domain · CD-01>>

AuthController --> AuthService
AuthController ..> AuthModule_DTOs
AuthService --> AccountStore
AuthService --> TokenService
AuthService --> PasswordService
AuthService --> GoogleOAuthService
TokenService ..> AuthSession : «write»
TokenService ..> PasswordResetToken : «write»
AccountStore ..> UserAccount : «write»
AccountStore ..> Explorer : «write»
AccountStore ..> StaffMember : «write»
AccountStore ..> UserIdentity : «write»
JwtAuthGuard --> TokenService
OccupationAccessGuard --> AccessPolicyService
MeController --> AccountService
MeController ..> UserModule_DTOs
UserAdminController --> UserAdminService
UserAdminController ..> UserModule_DTOs
StaffingController --> StaffingService
StaffingController ..> UserModule_DTOs
AccountService --> AccountStore
AccountService --> PasswordService
AccountService --> TokenService
UserAdminService --> AccountStore
UserAdminService --> TokenService
StaffingService ..> AssignedTo : «write»
legend bottom
  | Arrow | Meaning |
  | A --> B | association: A holds B through constructor injection (a controller holds its services) |
  | A ..> Entity : «write» | A writes the domain class (the module owns it; see CD-01 … CD-08) |
  | Controller ..> DTOs | the controller's routes take and return these types |
  | A ..\|> I | A realizes the interface or port I |
  | grey class | defined in another diagram (CL-0x · module, or domain · CD-0x) |
endlegend
@enduml
