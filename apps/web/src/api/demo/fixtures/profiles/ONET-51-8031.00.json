{
  "code": "ONET-51-8031.00",
  "name": "Vận hành nhà máy nước, xử lý nước thải",
  "nameEn": "Water and Wastewater Treatment Plant and System Operators",
  "group": "Sản xuất",
  "regionId": "ky_thuat",
  "isIt": false,
  "summary": "Vận hành hoặc điều khiển toàn bộ quy trình hay hệ thống máy, thường qua bảng điều khiển, để chuyển hoặc xử lý nước và nước thải. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Làm trong điều kiện nguy hiểm như điện cao thế, chất dễ cháy nổ hoặc hoá chất độc.",
    "Làm trong nhà nhưng không có kiểm soát nhiệt độ hay thông gió.",
    "Làm ngoài trời, chịu mọi điều kiện thời tiết.",
    "Làm trong không gian chật hoặc tư thế khó."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Thường ngồi trong xe hoặc cabin máy.",
    "33% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "43% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Hiện trường, công trường, ngoài trời"],
