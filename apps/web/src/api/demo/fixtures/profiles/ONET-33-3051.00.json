{
  "code": "ONET-33-3051.00",
  "name": "Cảnh sát (công an)",
  "nameEn": "Police and Sheriff's Patrol Officers",
  "group": "Dịch vụ bảo vệ an ninh và an toàn",
  "regionId": "dich_vu",
  "isIt": false,
  "summary": "Giữ trật tự, bảo vệ tính mạng và tài sản bằng cách thực thi pháp luật. Kết hợp các việc: tuần tra một khu vực, điều tiết giao thông, lập biên bản vi phạm giao thông, điều tra tai nạn, truy bắt nghi phạm hoặc tống đạt văn bản của toà. Gồm cả cảnh sát làm việc tại cơ sở giáo dục. Mức chuẩn bị: cần chuẩn bị ở mức vừa. Thường cần học nghề, cao đẳng hoặc chứng chỉ chuyên môn.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Có thể phải đối mặt với người hung hăng hoặc bạo lực.",
    "Thường xuyên gặp tình huống xung đột với người khác.",
    "Hay phải tiếp xúc với người khó chịu, giận dữ hoặc thiếu lịch sự.",
    "Làm ngoài trời, chịu mọi điều kiện thời tiết."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Thường ngồi trong xe hoặc cabin máy.",
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "39% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "37% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Hiện trường, công trường, ngoài trời"],
