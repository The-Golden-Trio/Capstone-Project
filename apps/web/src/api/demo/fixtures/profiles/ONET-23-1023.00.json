{
  "code": "ONET-23-1023.00",
  "name": "Thẩm phán",
  "nameEn": "Judges, Magistrate Judges, and Magistrates",
  "group": "Pháp lý",
  "regionId": "kinh_doanh",
  "isIt": false,
  "summary": "Phân xử, tư vấn, xét xử hoặc thực thi công lý tại toà án. Có thể tuyên án bị cáo trong vụ án hình sự theo luật và khung hình phạt. Có thể xác định trách nhiệm của bị đơn trong vụ án dân sự. Mức chuẩn bị: cần chuẩn bị rất nhiều. Thường cần bằng sau đại học, như thạc sĩ, tiến sĩ hoặc bằng chuyên ngành y, luật.",
  "fitSummary": "Hợp với người thích thuyết phục, dẫn dắt người khác và kinh doanh. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần làm việc bằng tay với máy móc, công cụ, vật thật.",
  "downsides": [
    "Ngồi gần như cả ngày.",
    "Thường xuyên gặp tình huống xung đột với người khác.",
    "Thường xuyên phải làm gấp cho kịp hạn."
  ],
  "workFacts": [
    "Phần lớn thời gian làm trong nhà, có điều hoà.",
    "Ngồi phần lớn thời gian làm việc.",
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "Làm việc độc lập nhiều hơn làm theo nhóm.",
    "Được tự quyết nhiều trong công việc.",
    "42% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "Gần như ai trong nghề cũng làm giờ cố định."
  ],
  "settings": ["Văn phòng"],
  "environments": [
    {
      "name": "Toà án",
      "weight": 100
    }
