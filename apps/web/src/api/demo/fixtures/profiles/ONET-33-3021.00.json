{
  "code": "ONET-33-3021.00",
  "name": "Điều tra viên",
  "nameEn": "Detectives and Criminal Investigators",
  "group": "Dịch vụ bảo vệ an ninh và an toàn",
  "regionId": "dich_vu",
  "isIt": false,
  "summary": "Điều tra các hành vi nghi vi phạm pháp luật để phòng ngừa hoặc phá án. Mức chuẩn bị: cần chuẩn bị ở mức vừa. Thường cần học nghề, cao đẳng hoặc chứng chỉ chuyên môn.",
  "fitSummary": "Hợp với người thích làm việc theo quy trình, chính xác với số liệu và giấy tờ. Nghề cũng cần tìm tòi, phân tích và giải quyết vấn đề bằng tư duy, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Làm ngoài trời, chịu mọi điều kiện thời tiết.",
    "Ngồi gần như cả ngày.",
    "Công việc lặp lại nhiều."
  ],
  "workFacts": [
    "Làm cả trong văn phòng lẫn ngoài hiện trường.",
    "Thường ngồi trong xe hoặc cabin máy.",
    "Ngồi phần lớn thời gian làm việc.",
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "47% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "36% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Hiện trường, công trường, ngoài trời"],
