{
  "code": "ONET-45-2092.00",
  "name": "Lao động trồng trọt",
  "nameEn": "Farmworkers and Laborers, Crop, Nursery, and Greenhouse",
  "group": "Nông nghiệp, ngư nghiệp và lâm nghiệp",
  "regionId": "ky_thuat",
  "isIt": false,
  "summary": "Trồng, chăm sóc và thu hoạch rau, quả, hạt, cây cảnh và cây trồng ngoài đồng bằng tay. Dùng dụng cụ như xẻng, bay, cuốc, đầm, liềm, kéo và dao. Có thể làm đất, bón phân, cấy, làm cỏ, tỉa thưa, cắt tỉa, phun thuốc, hoặc làm sạch, phân loại, đóng gói và bốc xếp nông sản. Có thể làm giàn, sửa hàng rào và chuồng trại, hoặc tham gia tưới tiêu. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Nhiều người trong nghề làm hơn 40 giờ mỗi tuần.",
    "Nhịp làm việc do tốc độ máy móc quyết định.",
    "Làm ngoài trời, chịu mọi điều kiện thời tiết.",
    "Tiếp xúc với nhiệt độ rất nóng hoặc rất lạnh."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Thường ngồi trong xe hoặc cabin máy.",
    "Đứng phần lớn thời gian làm việc.",
    "Ít tiếp xúc với khách hàng bên ngoài.",
    "Làm việc độc lập nhiều hơn làm theo nhóm.",
    "Ít được tự quyết, làm theo chỉ đạo và quy trình.",
    "Ít làm việc qua email.",
    "63% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "45% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Hiện trường, công trường, ngoài trời"],
