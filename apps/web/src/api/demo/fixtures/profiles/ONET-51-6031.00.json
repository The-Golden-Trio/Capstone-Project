{
  "code": "ONET-51-6031.00",
  "name": "Công nhân may mặc, da giày",
  "nameEn": "Sewing Machine Operators",
  "group": "Sản xuất",
  "regionId": "ky_thuat",
  "isIt": false,
  "summary": "Vận hành hoặc trông máy may để ráp, gia cố, trang trí hoặc làm các thao tác may khác trong sản xuất quần áo và sản phẩm khác. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần giúp đỡ, dạy bảo và chăm sóc người khác.",
  "downsides": [
    "Nhịp làm việc do tốc độ máy móc quyết định.",
    "Lặp đi lặp lại cùng một động tác.",
    "Hay phải cúi hoặc vặn người."
  ],
  "workFacts": [
    "Đứng phần lớn thời gian làm việc.",
    "Ít tiếp xúc với khách hàng bên ngoài.",
    "Làm việc độc lập nhiều hơn làm theo nhóm.",
    "Ít được tự quyết, làm theo chỉ đạo và quy trình.",
    "Ít làm việc qua email.",
    "25% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "28% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Nhà máy, xưởng, kho bãi"],
  "environments": [
    {
      "name": "Nhà máy FDI trong khu công nghiệp",
      "weight": 75
    },
    {
      "name": "Nhà máy doanh nghiệp trong nước",
      "weight": 25
    }
  ],
  "education": {
