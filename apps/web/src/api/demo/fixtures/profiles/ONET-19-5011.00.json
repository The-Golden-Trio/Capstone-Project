{
  "code": "ONET-19-5011.00",
  "name": "Chuyên viên an toàn lao động (HSE)",
  "nameEn": "Occupational Health and Safety Specialists",
  "group": "Khoa học tự nhiên và xã hội",
  "regionId": "cong_nghe",
  "isIt": false,
  "summary": "Xem xét, đánh giá và phân tích môi trường làm việc, thiết kế chương trình và quy trình để kiểm soát, loại bỏ, phòng ngừa bệnh tật hay chấn thương do tác nhân hoá học, vật lý, sinh học hoặc yếu tố công thái học. Có thể thanh tra và buộc tuân thủ luật về an toàn, sức khoẻ. Có thể làm cho khu vực nhà nước hoặc tư nhân. Mức chuẩn bị: cần chuẩn bị nhiều. Thường cần bằng đại học.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần tìm tòi, phân tích và giải quyết vấn đề bằng tư duy, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Nhiều người trong nghề làm hơn 40 giờ mỗi tuần.",
    "Lịch làm việc không cố định: theo ca, thay đổi hoặc theo mùa.",
    "Làm trong nhà nhưng không có kiểm soát nhiệt độ hay thông gió."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Thường ngồi trong xe hoặc cabin máy.",
    "63% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "54% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Hiện trường, công trường, ngoài trời"],
  "environments": [
    {
      "name": "Công trường của nhà thầu xây dựng",
