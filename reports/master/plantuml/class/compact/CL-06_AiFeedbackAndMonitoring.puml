@startuml CL-06_AiFeedbackAndMonitoring
title CL-06 · NestJS modules — AI, feedback and monitoring
hide empty members
skinparam classAttributeIconSize 0
left to right direction

package "AiModule" <<Rectangle>> {
  class AiModule <<module>> {
    imports: AuthModule
    controllers: SystemPromptController
    providers: ModelGatewayService, OpenRouterProvider, OpenAiCompatibleProvider, PromptBuilder, PromptService, DeIdentifierService, OutputCheckService, CostLedgerService
    exports: ModelGatewayService, PromptBuilder, DeIdentifierService, OutputCheckService
  }
  class SystemPromptController <<controller>> {
    -prompts : PromptService
    --
    +getSystemPrompts(user: AuthUser, occupationId: string) : SystemPrompt[]  «GET /staff/occupations/{occupationId}/prompts» [CA,DE]
    +saveSystemPrompt(user: AuthUser, occupationId: string, dto: PromptInput) : SystemPrompt  «PUT /staff/occupations/{occupationId}/prompts» [CA,DE]
  }
  class ModelGatewayService {
    <i>model families from the deployment config; judges ≠ narrator family</i>
    -providers : ModelProvider[]
    -cost : CostLedgerService
    -metrics : MetricsService
    -settings : SettingsService
    --
    +complete(task, prompt, ctx) : ModelReply
  }
  interface ModelProvider {
    +name : string
    +complete(model, prompt) : ModelReply
  }
  class OpenRouterProvider <<adapter>> {
    <i>judges, ZDR endpoints only (D-131)</i>
    -http : HttpService
  }
  class OpenAiCompatibleProvider <<adapter>> {
    <i>narrator (Qwen, DeepSeek), local models</i>
    -http : HttpService
  }
  class PromptBuilder {
    -prompts : PromptService
    --
    +narrator(occupationId, card, state) : Prompt  «narrator.v3»
    +judge(occupationId, transcript, questions) : Prompt
    +yesNo(conditions, transcript) : Prompt
    +feedbackNote(occupationId, transcript) : Prompt
  }
  class PromptService {
    <i>occupation.prompts; each save logged; 409 if baseVersion is old</i>
    -prisma : PrismaService
    -audit : AuditLogService
    --
    +list(user, occupationId) : SystemPrompt[]
    +save(user, occupationId, dto) : SystemPrompt
    +current(occupationId, kind) : string
  }
  class DeIdentifierService {
    +strip(text) : string  «name → {ten} placeholder»
  }
  class OutputCheckService {
    +checkNarration(beats, facts) : CheckResult  «R1–R4»
    +verifyQuotes(outcome, transcript) : boolean
    +checkNote(note) : CheckResult
  }
  class CostLedgerService {
    <i>ai_call</i>
    -prisma : PrismaService
    --
    +record(task, runId, reply) : void
    +sessionCost(runId) : number
  }
  class "AiModule DTOs" as AiModule_DTOs <<dto>> {
    PromptInput { kind, baseVersion, text, changeNote }
    SystemPrompt
  }
}

package "FeedbackModule" <<Rectangle>> {
  class FeedbackModule <<module>> {
    imports: AuthModule
    controllers: FeedbackController, FeedbackInboxController
    providers: FeedbackService
    exports: FeedbackService
    <i>feedback: occupation rating, app feedback, wrong-content flag</i>
  }
  class FeedbackController <<controller>> {
    -feedback : FeedbackService
    --
    +sendFeedback(user: AuthUser, dto: FeedbackInput) : FeedbackView  «POST /feedback» [EX,DE,CA]
    +getRatingSummary(user: AuthUser, occupationId: string) : RatingSummary  «GET /occupations/{occupationId}/ratings» [EX,CA]
  }
  class FeedbackInboxController <<controller>> {
    -feedback : FeedbackService
    --
    +listFeedback(user: AuthUser, query: ListQuery) : Page<FeedbackView>  «GET /staff/feedback» [DE,SA]
    +handleFeedback(user: AuthUser, feedbackId: string, dto: HandleFeedbackInput) : FeedbackView  «PATCH /staff/feedback/{feedbackId}» [DE,SA]
  }
  class FeedbackService {
    -prisma : PrismaService
    -settings : SettingsService
    -notifications : NotificationService
    --
    +send(user, dto) : FeedbackView  «RATING only after every level»
    +flag(tx, runId, dto) : void  «kind FLAG; notifies the DEs»
    +ratingSummary(occupationId) : RatingSummary  «withheld below threshold»
    +inbox(user, query) : Page<FeedbackView>  «DE: flags; SA: app feedback»
    +handle(user, id, dto) : FeedbackView
  }
  class "FeedbackModule DTOs" as FeedbackModule_DTOs <<dto>> {
    FeedbackInput { kind: RATING|APP, occupationId?, scores?: object, text? }
    HandleFeedbackInput { status }
    ListQuery { cursor?, limit?: integer, status?, kind? }
    FeedbackView
    RatingSummary
  }
}

package "MonitoringModule" <<Rectangle>> {
  class MonitoringModule <<module>> {
    imports: AuthModule
    controllers: StatisticsController, OperationsController
    providers: StatisticsService, OperationsService
    exports: —
  }
  class StatisticsController <<controller>> {
    -statistics : StatisticsService
    --
    +getOccupationStatistics(user: AuthUser, occupationId: string) : OccupationStatistics  «GET /staff/occupations/{occupationId}/statistics» [CA]
  }
  class OperationsController <<controller>> {
    -operations : OperationsService
    --
    +getMetrics(user: AuthUser, query: ListQuery) : Metrics  «GET /admin/metrics» [SA]
    +listAiCalls(user: AuthUser, query: ListQuery) : Page<AiCallView>  «GET /admin/ai-calls» [SA]
  }
  class StatisticsService {
    -prisma : PrismaService
    -settings : SettingsService
    --
    +forOccupation(id) : OccupationStatistics  «excludes play-test runs; stuck rate per level»
  }
  class OperationsService {
    -prisma : PrismaService
    -settings : SettingsService
    --
    +metrics(query) : Metrics  «cost per run vs ceiling, latency p95, failed calls»
    +aiCalls(query) : Page<AiCallView>
  }
  class "MonitoringModule DTOs" as MonitoringModule_DTOs <<dto>> {
    ListQuery { cursor?, limit?: integer, status?, kind? }
    AiCallView
    Metrics
    OccupationStatistics
  }
}


SystemPromptController --> PromptService
ModelGatewayService --> ModelProvider
ModelGatewayService --> CostLedgerService
OpenRouterProvider ..|> ModelProvider
OpenAiCompatibleProvider ..|> ModelProvider
PromptBuilder --> PromptService
FeedbackController --> FeedbackService
FeedbackInboxController --> FeedbackService
StatisticsController --> StatisticsService
OperationsController --> OperationsService
@enduml
