{
  "code": "ONET-49-3042.00",
  "name": "Thợ sửa máy công trình, máy nông nghiệp",
  "nameEn": "Mobile Heavy Equipment Mechanics, Except Engines",
  "group": "Lắp đặt, bảo trì và sửa chữa",
  "regionId": "ky_thuat",
  "isIt": false,
  "summary": "Chẩn đoán, điều chỉnh, sửa chữa hoặc đại tu máy cơ khí, thuỷ lực và khí nén di động như cần cẩu, máy ủi, máy san và băng tải dùng trong xây dựng, khai thác gỗ và khai mỏ. Mức chuẩn bị: cần chuẩn bị ở mức vừa. Thường cần học nghề, cao đẳng hoặc chứng chỉ chuyên môn.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Làm trong không gian chật hoặc tư thế khó.",
    "Hay phải quỳ, cúi, khom hoặc bò.",
    "Làm trong nhà nhưng không có kiểm soát nhiệt độ hay thông gió.",
    "Làm cạnh máy móc hoặc dụng cụ nguy hiểm, có nguy cơ tai nạn."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Thường ngồi trong xe hoặc cabin máy.",
    "Đứng phần lớn thời gian làm việc.",
    "Ít làm việc qua email.",
    "46% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "23% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Hiện trường, công trường, ngoài trời"],
