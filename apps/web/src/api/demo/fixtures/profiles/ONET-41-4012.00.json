{
  "code": "ONET-41-4012.00",
  "name": "Nhân viên kinh doanh (sales B2B)",
  "nameEn": "Sales Representatives, Wholesale and Manufacturing, Except Technical and Scientific Products",
  "group": "Bán hàng",
  "regionId": "kinh_doanh",
  "isIt": false,
  "summary": "Bán hàng của nhà bán buôn hoặc nhà sản xuất cho doanh nghiệp hoặc nhóm khách, không thuộc sản phẩm kỹ thuật và khoa học. Cần hiểu biết sâu về hàng mình bán. Mức chuẩn bị: cần chuẩn bị nhiều. Thường cần bằng đại học.",
  "fitSummary": "Hợp với người thích thuyết phục, dẫn dắt người khác và kinh doanh. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần tìm tòi, phân tích và giải quyết vấn đề bằng tư duy.",
  "downsides": [
    "Nhiều người trong nghề làm hơn 40 giờ mỗi tuần.",
    "Môi trường cạnh tranh cao.",
    "Ngồi gần như cả ngày."
  ],
  "workFacts": [
    "Thường ngồi trong xe hoặc cabin máy.",
    "Ngồi phần lớn thời gian làm việc.",
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "51% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "19% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
