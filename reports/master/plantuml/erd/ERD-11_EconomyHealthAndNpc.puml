@startuml ERD-11_EconomyHealthAndNpc
title ERD-11 · Economy, health, calendar and tarot NPCs
hide circle
' Sources: research/reports/Kinh tế và sức khoẻ JobQuest.md (Khối 1–5);
' research/reports/Hồ sơ NPC JobQuest.md (bản chốt v1.0, 6/11; §2, §5, §6.2, §8);
' 02-quyet-dinh D-133 (replaces the currency/health clause of D-110).
' Rules kept: no daily login, no player-to-player transfer, no fixed costs, xu never deducted
' as a penalty (Khối 1). Side quests are not scored (N5).

package "Xu and shop" {
' ── Xu: earned from real salary of the level (K2), ledger is append-only ──
entity "wallet" as wallet <<D-133>> #DDEBF7 {
  * explorer_id : uuid <<PK,FK>>
  --
  * balance : integer
  * savings : integer
  * savings_locked : integer
  * updated_at : timestamp
}

entity "xu_transaction" as xu_transaction <<D-133>> #DDEBF7 {
  * id : bigint <<PK>>
  --
  * explorer_id : uuid <<FK>>
  * kind : xu_txn_kind
  * amount : integer
    run_id : uuid <<FK>>
    shop_item_id : uuid <<FK>>
    milestone_id : uuid <<FK>>
  * created_at : timestamp
}

' ── Shop: 6 groups; progress items priced in u, lifestyle items in X (K6) ──
entity "shop_item" as shop_item <<D-133>> #DDEBF7 {
  * id : uuid <<PK>>
  --
  * code : varchar(40) <<UQ>>
  * item_group : shop_group
  * name : varchar(120)
  * price : numeric(5,2)
  * price_unit : price_unit
  * effect : jsonb
    soft_skill_group_id : uuid <<FK>>
    tier : smallint
    occasion_id : uuid <<FK>>
  * is_active : boolean
}

entity "inventory_item" as inventory_item <<D-133>> #DDEBF7 {
  * id : uuid <<PK>>
  --
  * explorer_id : uuid <<FK>>
  * shop_item_id : uuid <<FK>>
  * acquired_at : timestamp
    used_run_id : uuid <<FK>>
    used_at : timestamp
}

entity "decor_placement" as decor_placement <<cần chốt>> #FCE4D6 {
  * explorer_id : uuid <<PK,FK>>
  * slot : decor_slot <<PK>>
  --
  * inventory_item_id : uuid <<FK>>
  * placed_at : timestamp
}

entity "mission_prep" as mission_prep <<D-133>> #DDEBF7 {
  * run_id : uuid <<PK,FK>>
  --
    inventory_item_id : uuid <<FK,UQ>>
  * buff_total : numeric(3,2)
  * buff_breakdown : jsonb
}

}

package "Health and habits" {
' ── Health 0–100 (110 after the 10K milestone); tier changes the turn budget (S1) ──
entity "health_state" as health_state <<D-133>> #DDEBF7 {
  * explorer_id : uuid <<PK,FK>>
  --
  * value : smallint
  * cap : smallint
  * consecutive_ot : smallint
  * updated_at : timestamp
}

entity "health_change" as health_change <<D-133>> #DDEBF7 {
  * id : bigint <<PK>>
  --
  * explorer_id : uuid <<FK>>
  * delta : smallint
  * reason : health_reason
    run_id : uuid <<FK>>
  * created_at : timestamp
}

entity "career_habit" as career_habit <<cần chốt>> #FCE4D6 {
  * id : uuid <<PK>>
  --
  * code : varchar(40) <<UQ>>
  * name : varchar(80)
  * good_side : text
  * bad_side : text
  * acquire_rule : jsonb
}

entity "explorer_habit" as explorer_habit <<D-133>> #DDEBF7 {
  * explorer_id : uuid <<PK,FK>>
  * slot_no : smallint <<PK>>
  --
  * habit_id : uuid <<FK>>
  * progress : smallint
    acquired_at : timestamp
}

}

package "Calendar and milestones" {
' ── Calendar and life milestones (Khối 5) ──
entity "occasion" as occasion <<D-133>> #DDEBF7 {
  * id : uuid <<PK>>
  --
  * code : varchar(40) <<UQ>>
  * name : varchar(80)
  * kind : occasion_kind
    month_day : char(5)
}

entity "explorer_calendar" as explorer_calendar <<D-133>> #DDEBF7 {
  * explorer_id : uuid <<PK,FK>>
  --
  * game_date : date
  * gap_slots_left : smallint
  * updated_at : timestamp
}

entity "life_milestone" as life_milestone <<D-133>> #DDEBF7 {
  * id : uuid <<PK>>
  --
  * code : varchar(40) <<UQ>>
  * domain : varchar(40)
  * name : varchar(120)
    prerequisite : jsonb
  * scene : text
    buff_group_id : uuid <<FK>>
  * price_x : numeric(5,2)
  * locks_savings : boolean
}

entity "explorer_milestone" as explorer_milestone <<D-133>> #DDEBF7 {
  * explorer_id : uuid <<PK,FK>>
  * milestone_id : uuid <<PK,FK>>
  --
  * achieved_at : timestamp
    lost_at : timestamp
}

}

package "Tarot NPCs" {
' ── 22 tarot NPCs (Hồ sơ NPC v1.0) ──
entity "npc_card" as npc_card <<D-133>> #DDEBF7 {
  * id : uuid <<PK>>
  --
  * arcana_no : smallint <<UQ>>
  * code : varchar(40) <<UQ>>
  * version : varchar(10)
  * unlock_route : npc_unlock_route
  * display_name : varchar(40)
  * birthday : char(5)
  * colour_hex : char(7)
  * profile_person : jsonb
  * profile_private : jsonb
  * review_status : npc_review_status
  * updated_at : timestamp
}

entity "npc_ability" as npc_ability <<D-133>> #DDEBF7 {
  * id : uuid <<PK>>
  --
  * npc_card_id : uuid <<FK>>
  * code : varchar(40)
  * min_intimacy : smallint
  * description : text
  * notebook_text : text
  * effect : jsonb
}

entity "explorer_npc" as explorer_npc <<D-133>> #DDEBF7 {
  * explorer_id : uuid <<PK,FK>>
  * npc_card_id : uuid <<PK,FK>>
  --
  * unlock_route : npc_unlock_route
  * unlocked_at : timestamp
  * intimacy_level : smallint
  * intimacy_points : integer
  * chapters_done : jsonb
  * promises : jsonb
}

entity "npc_memory" as npc_memory <<D-133>> #DDEBF7 {
  * id : uuid <<PK>>
  --
  * explorer_id : uuid <<FK>>
  * npc_card_id : uuid <<FK>>
  * run_id : uuid <<FK>>
  * text : varchar(120)
  * present : jsonb
  * created_at : timestamp
}

entity "npc_asset" as npc_asset <<D-133>> #DDEBF7 {
  * npc_card_id : uuid <<PK,FK>>
  * kind : npc_asset_kind <<PK>>
  * code : varchar(20) <<PK>>
  --
  * asset_id : uuid <<FK>>
    outfit_group_id : uuid <<FK>>
    face_anchor : jsonb
}

entity "outfit_group" as outfit_group <<cần chốt>> #FCE4D6 {
  * id : uuid <<PK>>
  --
  * code : varchar(40) <<UQ>>
  * name : varchar(80)
  * batch_no : smallint
    fallback_id : uuid <<FK>>
}

}

entity "user_account\n(ERD-01)" as user_account
entity "scenario_run\n(ERD-05)" as scenario_run
entity "asset\n(ERD-04)" as asset
entity "soft_skill_group\n(ERD-08)" as soft_skill_group

wallet |o--|| user_account
xu_transaction }o--|| user_account
xu_transaction }o--o| scenario_run
xu_transaction }o--o| shop_item
xu_transaction }o--o| life_milestone
shop_item }o--o| soft_skill_group
shop_item }o--o| occasion
inventory_item }o--|| user_account
inventory_item }o--|| shop_item
inventory_item }o--o| scenario_run : used_run_id
decor_placement }o--|| user_account
decor_placement |o--|| inventory_item
mission_prep |o--|| scenario_run
mission_prep |o--o| inventory_item
health_state |o--|| user_account
health_change }o--|| user_account
health_change }o--o| scenario_run
explorer_habit }o--|| user_account
explorer_habit }o--|| career_habit
explorer_calendar |o--|| user_account
life_milestone }o--o| soft_skill_group
explorer_milestone }o--|| user_account
explorer_milestone }o--|| life_milestone
npc_ability }o--|| npc_card
explorer_npc }o--|| user_account
explorer_npc }o--|| npc_card
npc_memory }o--|| user_account
npc_memory }o--|| npc_card
npc_memory }o--|| scenario_run
npc_asset }o--|| npc_card
npc_asset }o--|| asset
npc_asset }o--o| outfit_group
outfit_group }o--o| outfit_group : fallback_id

note right of wallet
  xu per mission = round(100·√(salary/13M)), 60–250,
  stored on occupation_level.xu_per_mission (K2).
  u = xu per mission of the current occupation;
  X = per-band lifestyle scale (K6). Prices open (C5).
end note

note bottom of mission_prep
  At most one buff item or the Vận may card per mission.
  Total buff cap +50%: zodiac 12 + milestone 5 + item ≤ 30
  (or the card alone 50); applied last (D-116, C3).
end note

note bottom of health_state
  Sung sức ≥80 · Ổn 50–79 · Mệt 25–49 · Kiệt sức 0–24
  → turn modifier +1 / 0 / −1 / −2 (S1).
  OT: ≤2 per mission, +2 turns −12 / +1 −18 (S2);
  3 OT in a row halves recovery. Recovery amounts open (S3).
end note

note bottom of explorer_npc
  Intimacy Gặp → Thân → Gắn bó → Tri kỷ, never lost
  (level count open, N2). 6 cards open at start (N1);
  others by business card 1u/3u, newcomer slot, milestone (N3).
  Mission scenes do not change with intimacy;
  only side quests read npc_memory.
end note

legend right
  |<#DDEBF7>      | new, from a ✅ decision (stereotype = D-ID) |
  |<#FFF2CC>      | new, decided in research/, no D-ID yet |
  |<#FCE4D6>      | new, still "Cần chốt" (07 A28) |
  |<#FFFFFF>      | existing ERD-01..07 table |
endlegend
@enduml
