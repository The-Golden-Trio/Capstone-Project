{
  "code": "ONET-19-2042.00",
  "name": "Nhà khoa học địa chất, khí tượng thuỷ văn",
  "nameEn": "Geoscientists, Except Hydrologists and Geographers",
  "group": "Khoa học tự nhiên và xã hội",
  "regionId": "cong_nghe",
  "isIt": false,
  "summary": "Nghiên cứu thành phần, cấu trúc và các đặc điểm vật lý của trái đất. Có thể dùng kiến thức địa chất, vật lý, toán để thăm dò dầu khí, khoáng sản, nước ngầm, hoặc xử lý chất thải, cải tạo đất và các vấn đề môi trường. Có thể nghiên cứu cấu tạo bên trong, khí quyển, đại dương và các trường từ, điện, trọng lực của trái đất. Mức chuẩn bị: cần chuẩn bị nhiều. Thường cần bằng đại học.",
  "fitSummary": "Hợp với người thích tìm tòi, phân tích và giải quyết vấn đề bằng tư duy. Nghề cũng cần làm việc bằng tay với máy móc, công cụ, vật thật, nhưng ít cần thuyết phục, dẫn dắt người khác và kinh doanh.",
  "downsides": [
    "Ngồi gần như cả ngày.",
    "Kết quả nghiên cứu đến chậm, nhiều thí nghiệm thất bại.",
    "Phụ thuộc vào tài trợ và ngân sách nghiên cứu."
  ],
  "workFacts": [
    "Ngồi phần lớn thời gian làm việc.",
    "41% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "45% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Phòng thí nghiệm", "Văn phòng"],
