{
  "code": "ONET-49-3011.00",
  "name": "Kỹ thuật viên bảo dưỡng máy bay",
  "nameEn": "Aircraft Mechanics and Service Technicians",
  "group": "Lắp đặt, bảo trì và sửa chữa",
  "regionId": "ky_thuat",
  "isIt": false,
  "summary": "Chẩn đoán, điều chỉnh, sửa chữa hoặc đại tu động cơ và các cụm của máy bay như hệ thống thuỷ lực và khí nén. Mức chuẩn bị: cần chuẩn bị ở mức vừa. Thường cần học nghề, cao đẳng hoặc chứng chỉ chuyên môn.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Làm trong không gian chật hoặc tư thế khó.",
    "Làm trong nhà nhưng không có kiểm soát nhiệt độ hay thông gió.",
    "Làm trong điều kiện nguy hiểm như điện cao thế, chất dễ cháy nổ hoặc hoá chất độc.",
    "Tiếp xúc với khói, bụi, hoá chất, dầu mỡ hoặc mùi khó chịu."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Ít tiếp xúc với khách hàng bên ngoài.",
    "22% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "10% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Hiện trường, công trường, ngoài trời"],
