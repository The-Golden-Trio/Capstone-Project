{
  "code": "DATA_DE",
  "name": "Kỹ sư dữ liệu",
  "nameEn": "Data Engineer",
  "group": "Công nghệ thông tin",
  "regionId": "cong_nghe",
  "isIt": true,
  "summary": "Kỹ sư dữ liệu xây và vận hành đường ống đưa dữ liệu từ nhiều nguồn về kho dữ liệu, để người phân tích và hệ thống AI dùng được. Việc gồm viết job ETL/ELT, thiết kế kho dữ liệu, tối ưu xử lý dữ liệu lớn và giữ dữ liệu đúng, đủ, kịp giờ. Hiếm khi tuyển người mới; thường chuyển sang từ Back-end hoặc phân tích dữ liệu.",
  "fitSummary": "Hợp với người thích làm việc theo quy trình, chính xác với số liệu và giấy tờ. Nghề cũng cần tìm tòi, phân tích và giải quyết vấn đề bằng tư duy, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Pipeline lỗi ban đêm vẫn phải sửa trước giờ làm, vì báo cáo buổi sáng phụ thuộc vào nó.",
    "Nguồn dữ liệu bên ngoài đổi định dạng không báo trước là có thể gãy cả hệ thống.",
    "Chi phí xử lý dữ liệu lớn có thể tăng rất nhanh nếu thiết kế không cẩn thận.",
    "Kho dữ liệu lâu năm thường có nhiều bảng không rõ ai đang dùng, nên sửa gì cũng rủi ro."
  ],
  "workFacts": [
    "Phần lớn thời gian làm trong nhà, có điều hoà.",
    "Ngồi phần lớn thời gian làm việc.",
    "Ít tiếp xúc với khách hàng bên ngoài.",
    "45% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "12% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
