{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "REDIS_URL=redis://localhost:6380",
        "DATABASE_URL=postgresql://jobquest:jobquest@localhost:5433/jobquest",
        "DIRECT_URL=postgresql://jobquest:jobquest@localhost:5433/jobquest",
        "SMTP_URL=smtp://localhost:1025",
        "S3_ENDPOINT=http://localhost:9100",
        "S3_ACCESS_KEY=jobquest",
        "S3_SECRET_KEY=jobquest-dev",
        "pnpm",
        "exec",
        "nx",
        "run-many",
        "-t",
        "serve",
        "serve-worker",
        "--projects=@datn/api"
      ],
      "port": 3000
    },
    {
      "name": "staff",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "nx", "run", "@datn/staff:serve"],
      "port": 4300
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "nx", "run", "@datn/web:serve"],
      "port": 4200
    },
    {
      "name": "web-mock",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_PLAY_API=mock",
        "pnpm",
        "--dir",
        "apps/web",
        "exec",
        "vite",
        "--port",
        "4210",
        "--strictPort"
      ],
      "port": 4210
    }
  ]
}
