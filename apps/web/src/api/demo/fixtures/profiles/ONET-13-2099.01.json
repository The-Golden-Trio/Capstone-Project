{
  "code": "ONET-13-2099.01",
  "name": "Chuyên viên phân tích tài chính định lượng (quant)",
  "nameEn": "Financial Quantitative Analysts",
  "group": "Kinh doanh và tài chính",
  "regionId": "kinh_doanh",
  "isIt": false,
  "summary": "Phát triển kỹ thuật định lượng phục vụ đầu tư chứng khoán, cổ phiếu, định giá công cụ tài chính. Xây mô hình toán học, thống kê cho quản trị rủi ro, tối ưu tài sản, định giá hoặc phân tích giá trị tương đối. Mức chuẩn bị: cần chuẩn bị rất nhiều. Thường cần bằng sau đại học, như thạc sĩ, tiến sĩ hoặc bằng chuyên ngành y, luật.",
  "fitSummary": "Hợp với người thích tìm tòi, phân tích và giải quyết vấn đề bằng tư duy. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần giúp đỡ, dạy bảo và chăm sóc người khác.",
  "downsides": [
    "Nhiều người trong nghề làm hơn 40 giờ mỗi tuần.",
    "Môi trường cạnh tranh cao.",
    "Ngồi gần như cả ngày."
  ],
  "workFacts": [
    "Ngồi phần lớn thời gian làm việc.",
    "Ít tiếp xúc với khách hàng bên ngoài.",
    "Ít được tự quyết, làm theo chỉ đạo và quy trình.",
    "75% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "20% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Văn phòng"],
