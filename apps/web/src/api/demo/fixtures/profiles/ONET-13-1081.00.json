{
  "code": "ONET-13-1081.00",
  "name": "Chuyên viên logistics và xuất nhập khẩu",
  "nameEn": "Logisticians",
  "group": "Kinh doanh và tài chính",
  "regionId": "kinh_doanh",
  "isIt": false,
  "summary": "Phân tích và điều phối các hoạt động logistics của doanh nghiệp hoặc tổ chức. Chịu trách nhiệm toàn bộ vòng đời sản phẩm, gồm mua, phân phối, phân bổ nội bộ, giao hàng và thanh lý. Mức chuẩn bị: cần chuẩn bị nhiều. Thường cần bằng đại học.",
  "fitSummary": "Hợp với người thích làm việc theo quy trình, chính xác với số liệu và giấy tờ. Nghề cũng cần thuyết phục, dẫn dắt người khác và kinh doanh, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Nhiều người trong nghề làm hơn 40 giờ mỗi tuần.",
    "Thường xuyên phải làm gấp cho kịp hạn.",
    "Ngồi gần như cả ngày."
  ],
  "workFacts": [
    "Ngồi phần lớn thời gian làm việc.",
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "62% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "19% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Văn phòng"],
