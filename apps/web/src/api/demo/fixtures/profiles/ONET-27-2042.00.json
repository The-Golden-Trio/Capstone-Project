{
  "code": "ONET-27-2042.00",
  "name": "Ca sĩ, nhạc công",
  "nameEn": "Musicians and Singers",
  "group": "Nghệ thuật, thiết kế, giải trí, thể thao và truyền thông",
  "regionId": "sang_tao",
  "isIt": false,
  "summary": "Chơi một hoặc nhiều nhạc cụ hoặc hát. Có thể biểu diễn trên sân khấu, cho phát sóng hoặc thu âm, ghi hình. Mức chuẩn bị: cần chuẩn bị nhiều. Thường cần bằng đại học.",
  "fitSummary": "Hợp với người thích sáng tạo và tự do thể hiện ý tưởng. Nghề cũng cần thuyết phục, dẫn dắt người khác và kinh doanh, nhưng ít cần tìm tòi, phân tích và giải quyết vấn đề bằng tư duy.",
  "downsides": [
    "Lịch làm việc không cố định: theo ca, thay đổi hoặc theo mùa.",
    "Môi trường cạnh tranh cao.",
    "Thu nhập bấp bênh, nhiều người làm theo dự án hoặc tự do."
  ],
  "workFacts": [
    "24% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "55% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Phòng thu, sân khấu, trường quay"],
  "environments": [
