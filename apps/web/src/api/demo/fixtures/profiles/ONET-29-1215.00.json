{
  "code": "ONET-29-1215.00",
  "name": "Bác sĩ",
  "nameEn": "Family Medicine Physicians",
  "group": "Y tế chuyên môn và kỹ thuật y tế",
  "regionId": "suc_khoe",
  "isIt": false,
  "summary": "Khám, chẩn đoán và điều trị bệnh: hỏi bệnh, khám lâm sàng, chỉ định xét nghiệm và chẩn đoán hình ảnh, kê đơn, làm thủ thuật, theo dõi người bệnh và tư vấn phòng bệnh. Sau khi học y khoa và thực hành, bác sĩ chọn một chuyên khoa như nội, nhi, sản, tâm thần, gây mê, chẩn đoán hình ảnh hay y học gia đình; chuyên khoa là biến thể của nghề. Mức chuẩn bị: cần chuẩn bị rất nhiều. Thường cần bằng sau đại học, như thạc sĩ, tiến sĩ hoặc bằng chuyên ngành y, luật.",
  "fitSummary": "Hợp với người thích tìm tòi, phân tích và giải quyết vấn đề bằng tư duy. Nghề cũng cần giúp đỡ, dạy bảo và chăm sóc người khác, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Nhiều người trong nghề làm hơn 40 giờ mỗi tuần.",
    "Có nguy cơ tiếp xúc với bệnh truyền nhiễm.",
    "Sai sót có thể gây hậu quả nghiêm trọng."
  ],
  "workFacts": [
    "Phần lớn thời gian làm trong nhà, có điều hoà.",
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "Làm việc theo nhóm là chính.",
    "Được tự quyết nhiều trong công việc.",
    "65% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "12% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Bệnh viện, phòng khám, cơ sở chăm sóc"],
