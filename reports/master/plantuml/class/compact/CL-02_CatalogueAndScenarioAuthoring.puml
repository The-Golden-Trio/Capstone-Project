@startuml CL-02_CatalogueAndScenarioAuthoring
title CL-02 · NestJS modules — Catalogue and scenario authoring
hide empty members
skinparam classAttributeIconSize 0
left to right direction

package "CatalogueModule" <<Rectangle>> {
  class CatalogueModule <<module>> {
    imports: AuthModule
    controllers: CatalogueController, OccupationController
    providers: CatalogueService, OccupationService, OccupationDataLoader
    exports: CatalogueService
  }
  class CatalogueController <<controller>> {
    -catalogue : CatalogueService
    --
    +getGalaxyMap(user: AuthUser) : GalaxyMap  «GET /occupations» [EX]
    +getOccupation(user: AuthUser, occupationId: string) : OccupationView  «GET /occupations/{occupationId}» [EX]
    +getLevel(user: AuthUser, levelId: string) : LevelView  «GET /levels/{levelId}» [EX]
  }
  class OccupationController <<controller>> {
    -occupations : OccupationService
    --
    +listMyOccupations(user: AuthUser) : StaffOccupation[]  «GET /staff/occupations» [CA,DE]
    +updateOccupation(user: AuthUser, occupationId: string, dto: OccupationUpdateInput) : StaffOccupation  «PATCH /staff/occupations/{occupationId}» [CA,DE]
    +getLevelPackage(user: AuthUser, levelId: string) : LevelPackage  «GET /staff/levels/{levelId}» [CA,DE]
  }
  class CatalogueService {
    -prisma : PrismaService
    -data : GameData
    --
    +galaxyMap(user) : GalaxyMap
    +occupation(user, id) : OccupationView
    +level(user, id) : LevelView
  }
  class OccupationService {
    -prisma : PrismaService
    -audit : AuditLogService
    --
    +listAssigned(user) : StaffOccupation[]
    +update(user, id, dto) : StaffOccupation  «CA: status; DE: profile»
    +levelPackage(levelId) : LevelPackage
  }
  class OccupationDataLoader <<command>> {
    <i>CLI: loads occupation-data (221 occupations, levels, budgets, ESCO keywords, 22 NPC) — replaces the import screens</i>
    -prisma : PrismaService
    -storage : StorageService
    --
    +run(path) : LoadReport
    -upsertOccupation(json) : void
    -upsertLevels(json) : void
    -upsertNpcs(yaml) : void
  }
  class "CatalogueModule DTOs" as CatalogueModule_DTOs <<dto>> {
    OccupationUpdateInput { status?, profile? }
    GalaxyMap
    LevelPackage
    LevelView
    OccupationView
    StaffOccupation
  }
}

package "ScenarioModule" <<Rectangle>> {
  class ScenarioModule <<module>> {
    imports: AuthModule, LifecycleModule
    controllers: ScenarioController, SeedController
    providers: ScenarioService, SeedService, SeedValidator
    exports: —
  }
  class ScenarioController <<controller>> {
    -scenarios : ScenarioService
    --
    +listScenarios(user: AuthUser, query: ListQuery) : Page<ScenarioListItem>  «GET /staff/scenarios» [CA,DE]
    +openScenario(user: AuthUser, dto: OpenScenarioInput) : ScenarioDetail  «POST /staff/scenarios» [CA]
    +getScenario(user: AuthUser, scenarioId: string) : ScenarioDetail  «GET /staff/scenarios/{scenarioId}» [CA,DE]
    +assignAuthor(user: AuthUser, scenarioId: string, dto: AssignAuthorInput) : ScenarioDetail  «PUT /staff/scenarios/{scenarioId}/author» [CA]
    +getScenarioHistory(user: AuthUser, scenarioId: string) : LifecycleEntry[]  «GET /staff/scenarios/{scenarioId}/history» [CA,DE]
  }
  class SeedController <<controller>> {
    -seeds : SeedService
    --
    +saveSeed(user: AuthUser, scenarioId: string, dto: SeedInput) : ScenarioDetail  «PUT /staff/scenarios/{scenarioId}/seed» [DE]
    +checkSeed(user: AuthUser, scenarioId: string) : CheckReport  «POST /staff/scenarios/{scenarioId}/checks» [DE]
    +submitScenario(user: AuthUser, scenarioId: string) : ScenarioDetail  «POST /staff/scenarios/{scenarioId}/submit» [DE]
  }
  class ScenarioService {
    -prisma : PrismaService
    -lifecycle : ScenarioStateMachine
    -access : AccessPolicyService
    -notifications : NotificationService
    --
    +list(user, query) : Page<ScenarioListItem>
    +open(user, dto) : ScenarioDetail  «409 if the slot code is active»
    +get(user, id) : ScenarioDetail
    +assignAuthor(user, id, dto) : ScenarioDetail
    +history(id) : LifecycleEntry[]
  }
  class SeedService {
    -prisma : PrismaService
    -validator : SeedValidator
    -lifecycle : ScenarioStateMachine
    -notifications : NotificationService
    --
    +save(user, id, dto) : ScenarioDetail  «DRAFT only, author only, 412 on row_version»
    +check(id) : CheckReport
    +submit(user, id) : ScenarioDetail
  }
  class SeedValidator {
    <i>seed rules: open/mid/end nodes, end node is a written format, ≥ 1 closed node, ≤ 1 timed node, 3–6 observed sub-skills, limits said aloud, facts referenced exist, budget shares sum to 100%</i>
    -data : GameData
    --
    +check(seed, level) : CheckReport
  }
  class "ScenarioModule DTOs" as ScenarioModule_DTOs <<dto>> {
    AssignAuthorInput { authorId }
    ListQuery { cursor?, limit?: integer, status?, kind? }
    OpenScenarioInput { levelId, kind, code, npcId? }
    SeedInput { seed, rowVersion }
    CheckReport
    LifecycleEntry
    ScenarioDetail
    ScenarioListItem
  }
}

package "LifecycleModule" <<Rectangle>> {
  class LifecycleModule <<module>> {
    imports: —
    controllers: —
    providers: ScenarioStateMachine
    exports: ScenarioStateMachine
  }
  class ScenarioStateMachine {
    <i>TRANSITIONS = SM-01; every transition is written to audit_log in the same transaction</i>
    -prisma : PrismaService
    -audit : AuditLogService
    --
    +apply(tx, scenarioId, action, actor) : ScenarioStatus
    +allowedActions(status, role) : LifecycleAction[]
    +history(scenarioId) : LifecycleEntry[]
  }
  enum LifecycleAction {
    OPEN
    SUBMIT
    START_REVIEW
    REQUEST_CHANGES
    REJECT
    APPROVE
    BUILD_DRAFT
    REPORT_ISSUE
    PASS_PLAYTEST
    PUBLISH
    DELETE
  }
}

class AccessPolicyService <<CL-01 · AuthModule>>

CatalogueController --> CatalogueService
OccupationController --> OccupationService
ScenarioController --> ScenarioService
SeedController --> SeedService
ScenarioService --> ScenarioStateMachine
ScenarioService --> AccessPolicyService
SeedService --> SeedValidator
SeedService --> ScenarioStateMachine
@enduml
