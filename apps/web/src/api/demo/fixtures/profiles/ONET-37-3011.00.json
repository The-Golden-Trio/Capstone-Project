{
  "code": "ONET-37-3011.00",
  "name": "Công nhân cảnh quan và cây xanh",
  "nameEn": "Landscaping and Groundskeeping Workers",
  "group": "Vệ sinh và bảo dưỡng toà nhà, cảnh quan",
  "regionId": "dich_vu",
  "isIt": false,
  "summary": "Làm và chăm sóc cảnh quan khuôn viên bằng dụng cụ cầm tay hoặc máy. Công việc thường gồm trải thảm cỏ, cắt cỏ, cắt tỉa, trồng cây, tưới nước, bón phân, đào xới, cào, lắp hệ thống tưới và xây tường chắn bằng khối bê tông lắp ghép. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Lịch làm việc không cố định: theo ca, thay đổi hoặc theo mùa.",
    "Nhiều người trong nghề làm hơn 40 giờ mỗi tuần.",
    "Làm ngoài trời, chịu mọi điều kiện thời tiết.",
    "Tiếp xúc với nhiệt độ rất nóng hoặc rất lạnh."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Thường ngồi trong xe hoặc cabin máy.",
    "Đứng phần lớn thời gian làm việc.",
    "Làm việc độc lập nhiều hơn làm theo nhóm.",
    "Ít làm việc qua email.",
    "57% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "65% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Hiện trường, công trường, ngoài trời"],
