{
  "code": "ONET-51-9071.00",
  "name": "Thợ kim hoàn",
  "nameEn": "Jewelers and Precious Stone and Metal Workers",
  "group": "Sản xuất",
  "regionId": "ky_thuat",
  "isIt": false,
  "summary": "Thiết kế, chế tác, chỉnh sửa, sửa chữa hoặc thẩm định trang sức, vàng, bạc, kim loại quý khác hoặc đá quý. Mức chuẩn bị: cần chuẩn bị ở mức vừa. Thường cần học nghề, cao đẳng hoặc chứng chỉ chuyên môn.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần giúp đỡ, dạy bảo và chăm sóc người khác.",
  "downsides": [
    "Ngồi gần như cả ngày.",
    "Thường xuyên phải làm gấp cho kịp hạn.",
    "Thường xuyên gặp tình huống xung đột với người khác."
  ],
  "workFacts": [
    "Phần lớn thời gian làm trong nhà, có điều hoà.",
    "Ngồi phần lớn thời gian làm việc.",
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "Làm việc độc lập nhiều hơn làm theo nhóm.",
    "Được tự quyết nhiều trong công việc.",
    "46% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "10% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Nhà máy, xưởng, kho bãi", "Văn phòng"],
