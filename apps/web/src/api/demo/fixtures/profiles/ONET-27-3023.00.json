{
  "code": "ONET-27-3023.00",
  "name": "Phóng viên, nhà báo",
  "nameEn": "News Analysts, Reporters, and Journalists",
  "group": "Nghệ thuật, thiết kế, giải trí, thể thao và truyền thông",
  "regionId": "sang_tao",
  "isIt": false,
  "summary": "Viết hoặc dẫn tin, bài bình luận, phê bình cho báo in, phát thanh, truyền hình hoặc phương tiện truyền thông khác. Có thể thu thập và phân tích thông tin qua phỏng vấn, điều tra hoặc quan sát. Mức chuẩn bị: cần chuẩn bị nhiều. Thường cần bằng đại học.",
  "fitSummary": "Hợp với người thích sáng tạo và tự do thể hiện ý tưởng. Nghề cũng cần thuyết phục, dẫn dắt người khác và kinh doanh, nhưng ít cần làm việc bằng tay với máy móc, công cụ, vật thật.",
  "downsides": [
    "Thường xuyên phải làm gấp cho kịp hạn.",
    "Môi trường cạnh tranh cao.",
    "Ngồi gần như cả ngày."
  ],
  "workFacts": [
    "Phần lớn thời gian làm trong nhà, có điều hoà.",
    "Thường ngồi trong xe hoặc cabin máy.",
    "Ngồi phần lớn thời gian làm việc.",
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "44% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "22% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Văn phòng"],
