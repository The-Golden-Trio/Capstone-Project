{
  "code": "ONET-43-5051.00",
  "name": "Nhân viên bưu chính",
  "nameEn": "Postal Service Clerks",
  "group": "Văn phòng và hỗ trợ hành chính",
  "regionId": "kinh_doanh",
  "isIt": false,
  "summary": "Làm các việc ở bưu cục như nhận thư và bưu kiện; bán tem, bưu thiếp và phong bì có tem; lập và bán phiếu chuyển tiền; chia thư vào ô, túi; kiểm tra cước thư. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc theo quy trình, chính xác với số liệu và giấy tờ. Nghề cũng cần làm việc bằng tay với máy móc, công cụ, vật thật, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Lặp đi lặp lại cùng một động tác.",
    "Hay phải cúi hoặc vặn người.",
    "Phải đứng trong phần lớn thời gian làm việc.",
    "Hay phải tiếp xúc với người khó chịu, giận dữ hoặc thiếu lịch sự."
  ],
  "workFacts": [
    "Phần lớn thời gian làm trong nhà, có điều hoà.",
    "Đứng phần lớn thời gian làm việc.",
    "Ít tiếp xúc với khách hàng bên ngoài.",
    "Ít được tự quyết, làm theo chỉ đạo và quy trình.",
    "Ít làm việc qua email.",
    "34% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "16% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Nhà máy, xưởng, kho bãi"],
