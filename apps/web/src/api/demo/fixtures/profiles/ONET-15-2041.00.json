{
  "code": "ONET-15-2041.00",
  "name": "Chuyên viên thống kê và toán ứng dụng",
  "nameEn": "Statisticians",
  "group": "Toán học và thống kê",
  "regionId": "cong_nghe",
  "isIt": false,
  "summary": "Phát triển hoặc áp dụng lý thuyết và phương pháp toán học, thống kê để thu thập, sắp xếp, diễn giải và tóm tắt dữ liệu số thành thông tin dùng được. Có thể chuyên về thống kê sinh học, nông nghiệp, kinh doanh hoặc kinh tế. Gồm cả nhà thống kê toán học và thống kê điều tra. Mức chuẩn bị: cần chuẩn bị rất nhiều. Thường cần bằng sau đại học, như thạc sĩ, tiến sĩ hoặc bằng chuyên ngành y, luật.",
  "fitSummary": "Hợp với người thích tìm tòi, phân tích và giải quyết vấn đề bằng tư duy. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần thuyết phục, dẫn dắt người khác và kinh doanh.",
  "downsides": [
    "Ngồi gần như cả ngày.",
    "Công việc trừu tượng, kết quả khó giải thích cho người không có nền toán.",
    "Thường cần bằng cấp cao và nhiều năm học."
  ],
  "workFacts": [
    "Ngồi phần lớn thời gian làm việc.",
    "Ít tiếp xúc với khách hàng bên ngoài.",
    "43% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "18% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Văn phòng"],
