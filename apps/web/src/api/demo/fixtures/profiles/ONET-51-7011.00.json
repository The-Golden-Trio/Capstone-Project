{
  "code": "ONET-51-7011.00",
  "name": "Thợ mộc đồ gỗ nội thất",
  "nameEn": "Cabinetmakers and Bench Carpenters",
  "group": "Sản xuất",
  "regionId": "ky_thuat",
  "isIt": false,
  "summary": "Cắt, tạo hình và lắp ráp đồ gỗ hoặc cài đặt và vận hành nhiều loại máy chế biến gỗ như cưa máy, máy bào cuốn, máy đục mộng để bào, cắt, tạo hình gỗ hoặc làm chi tiết cho sản phẩm gỗ. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần thuyết phục, dẫn dắt người khác và kinh doanh.",
  "downsides": [
    "Làm cạnh máy móc hoặc dụng cụ nguy hiểm, có nguy cơ tai nạn.",
    "Làm trong nhà nhưng không có kiểm soát nhiệt độ hay thông gió.",
    "Phải đứng trong phần lớn thời gian làm việc.",
    "Tiếp xúc với khói, bụi, hoá chất, dầu mỡ hoặc mùi khó chịu."
  ],
  "workFacts": [
    "Đứng phần lớn thời gian làm việc.",
    "Ít tiếp xúc với khách hàng bên ngoài.",
    "Làm việc độc lập nhiều hơn làm theo nhóm.",
    "Ít được tự quyết, làm theo chỉ đạo và quy trình.",
    "Ít làm việc qua email.",
    "34% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "18% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Nhà máy, xưởng, kho bãi"],
  "environments": [
    {
      "name": "Xưởng nhỏ, cơ sở gia đình, làng nghề",
      "weight": 60
