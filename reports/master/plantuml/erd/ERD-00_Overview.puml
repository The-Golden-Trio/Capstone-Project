@startuml ERD-00_Overview
title ERD-00 · JobQuest data model overview
hide circle

package "ERD-01 Identity and access" {
  entity "user_account" as user_account
  entity "staff_assignment" as staff_assignment
}
package "ERD-02 Occupation catalogue and profile" {
  entity "occupation" as occupation
  entity "occupation_level" as occupation_level
  entity "competency" as competency
  entity "task" as task
}
package "ERD-03 Scenario authoring" {
  entity "scenario" as scenario
  entity "activity" as activity
  entity "rubric_criterion" as rubric_criterion
}
package "ERD-04 Review, presentation and release" {
  entity "review_assignment" as review_assignment
  entity "review" as review
  entity "scenario_build" as scenario_build
  entity "scenario_release" as scenario_release
}
package "ERD-05 Exploration and progress" {
  entity "enrolment" as enrolment
  entity "scenario_run" as scenario_run
  entity "competency_credit" as competency_credit
}
package "ERD-06 Answers and assessment" {
  entity "answer" as answer
  entity "assessment" as assessment
}
package "ERD-07 Operations and settings" {
  entity "ai_job" as ai_job
}

