{
  "code": "ONET-27-1013.00",
  "name": "Hoạ sĩ, nghệ nhân",
  "nameEn": "Fine Artists, Including Painters, Sculptors, and Illustrators",
  "group": "Nghệ thuật, thiết kế, giải trí, thể thao và truyền thông",
  "regionId": "sang_tao",
  "isIt": false,
  "summary": "Sáng tác tác phẩm nghệ thuật gốc bằng nhiều chất liệu và kỹ thuật khác nhau. Mức chuẩn bị: cần chuẩn bị ở mức vừa. Thường cần học nghề, cao đẳng hoặc chứng chỉ chuyên môn.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần sáng tạo và tự do thể hiện ý tưởng, nhưng ít cần giúp đỡ, dạy bảo và chăm sóc người khác.",
  "downsides": [
    "Lặp đi lặp lại cùng một động tác.",
    "Dễ bị bỏng nhẹ, đứt tay, bị cắn hoặc đốt.",
    "Tiếp xúc với khói, bụi, hoá chất, dầu mỡ hoặc mùi khó chịu."
  ],
  "workFacts": [
    "Làm việc độc lập nhiều hơn làm theo nhóm.",
    "26% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "48% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Phòng thu, sân khấu, trường quay"],
  "environments": [
    {
      "name": "Freelance sáng tạo theo show, dự án",
      "weight": 60
    },
    {
      "name": "Xưởng nhỏ, cơ sở gia đình, làng nghề",
      "weight": 40
    }
  ],
  "education": {
    "preparation": "Cần chuẩn bị ở mức vừa",
    "note": "Thường cần học nghề, cao đẳng hoặc chứng chỉ chuyên môn. Theo O*NET (Mỹ).",
    "university": ["Hội họa", "Mỹ thuật tạo hình", "Thủ công mỹ nghệ"],
