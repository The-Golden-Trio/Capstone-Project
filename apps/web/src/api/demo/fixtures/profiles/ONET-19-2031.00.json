{
  "code": "ONET-19-2031.00",
  "name": "Nhà hoá học, chuyên viên kiểm nghiệm",
  "nameEn": "Chemists",
  "group": "Khoa học tự nhiên và xã hội",
  "regionId": "cong_nghe",
  "isIt": false,
  "summary": "Phân tích hoá học định tính, định lượng hoặc làm thí nghiệm trong phòng thí nghiệm để kiểm soát chất lượng, kiểm soát quy trình hoặc phát triển sản phẩm, tri thức mới. Mức chuẩn bị: cần chuẩn bị nhiều. Thường cần bằng đại học.",
  "fitSummary": "Hợp với người thích tìm tòi, phân tích và giải quyết vấn đề bằng tư duy. Nghề cũng cần làm việc bằng tay với máy móc, công cụ, vật thật, nhưng ít cần giúp đỡ, dạy bảo và chăm sóc người khác.",
  "downsides": [
    "Làm trong điều kiện nguy hiểm như điện cao thế, chất dễ cháy nổ hoặc hoá chất độc.",
    "Tiếp xúc với khói, bụi, hoá chất, dầu mỡ hoặc mùi khó chịu.",
    "Sai sót có thể gây hậu quả nghiêm trọng."
  ],
  "workFacts": [
    "Phần lớn thời gian làm trong nhà, có điều hoà.",
    "Ít tiếp xúc với khách hàng bên ngoài.",
    "44% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "14% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Phòng thí nghiệm"],
  "environments": [
