{
  "code": "ONET-51-9061.00",
  "name": "Nhân viên kiểm tra chất lượng sản xuất (QC)",
  "nameEn": "Inspectors, Testers, Sorters, Samplers, and Weighers",
  "group": "Sản xuất",
  "regionId": "ky_thuat",
  "isIt": false,
  "summary": "Kiểm tra, thử nghiệm, phân loại, lấy mẫu hoặc cân nguyên liệu và sản phẩm đã gia công, chế tạo, lắp ráp để phát hiện lỗi, mòn và sai lệch so với yêu cầu. Có thể dùng dụng cụ đo chính xác và thiết bị thử phức tạp. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần giúp đỡ, dạy bảo và chăm sóc người khác.",
  "downsides": [
    "Làm trong nhà nhưng không có kiểm soát nhiệt độ hay thông gió.",
    "Nhiều người trong nghề làm hơn 40 giờ mỗi tuần.",
    "Tiếp xúc với khói, bụi, hoá chất, dầu mỡ hoặc mùi khó chịu.",
    "Nhịp làm việc do tốc độ máy móc quyết định."
  ],
  "workFacts": [
    "Đứng phần lớn thời gian làm việc.",
    "Làm việc theo nhóm là chính.",
    "51% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "26% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Nhà máy, xưởng, kho bãi"],
