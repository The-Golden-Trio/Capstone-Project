{
  "code": "ONET-49-3052.00",
  "name": "Thợ sửa xe máy",
  "nameEn": "Motorcycle Mechanics",
  "group": "Lắp đặt, bảo trì và sửa chữa",
  "regionId": "ky_thuat",
  "isIt": false,
  "summary": "Chẩn đoán, điều chỉnh, sửa chữa hoặc đại tu xe máy, xe tay ga, xe gắn máy, xe địa hình và phương tiện có động cơ tương tự. Mức chuẩn bị: cần chuẩn bị ở mức vừa. Thường cần học nghề, cao đẳng hoặc chứng chỉ chuyên môn.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Hay phải quỳ, cúi, khom hoặc bò.",
    "Làm trong không gian chật hoặc tư thế khó.",
    "Phải đứng trong phần lớn thời gian làm việc.",
    "Hay phải cúi hoặc vặn người."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Đứng phần lớn thời gian làm việc.",
    "Tiếp xúc nhiều với khách hàng hoặc người dân.",
    "Làm việc độc lập nhiều hơn làm theo nhóm.",
    "Được tự quyết nhiều trong công việc.",
    "Ít làm việc qua email.",
    "49% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "39% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
