{
  "code": "ONET-11-3051.00",
  "name": "Quản lý sản xuất",
  "nameEn": "Industrial Production Managers",
  "group": "Quản lý",
  "regionId": "kinh_doanh",
  "isIt": false,
  "summary": "Lập kế hoạch, chỉ đạo và điều phối công việc và nguồn lực cần để sản xuất sản phẩm đúng yêu cầu về chi phí, chất lượng và số lượng. Mức chuẩn bị: cần chuẩn bị nhiều. Thường cần bằng đại học.",
  "fitSummary": "Hợp với người thích thuyết phục, dẫn dắt người khác và kinh doanh. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Nhiều người trong nghề làm hơn 40 giờ mỗi tuần.",
    "Chịu trách nhiệm trực tiếp về sức khoẻ và an toàn của người khác.",
    "Thường xuyên gặp tình huống xung đột với người khác."
  ],
  "workFacts": [
    "Làm việc theo nhóm là chính.",
    "84% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "18% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Nhà máy, xưởng, kho bãi"],
  "environments": [
    {
      "name": "Nhà máy FDI trong khu công nghiệp",
      "weight": 50
    },
    {
      "name": "Nhà máy doanh nghiệp trong nước",
      "weight": 40
    },
    {
      "name": "Nhà máy chế biến thực phẩm, thuỷ sản",
      "weight": 10
    }
  ],
  "education": {
    "preparation": "Cần chuẩn bị nhiều",
    "note": "Thường cần bằng đại học. Theo O*NET (Mỹ).",
