{
  "code": "ONET-39-5092.00",
  "name": "Thợ làm móng",
  "nameEn": "Manicurists and Pedicurists",
  "group": "Chăm sóc và dịch vụ cá nhân",
  "regionId": "dich_vu",
  "isIt": false,
  "summary": "Làm sạch và tạo dáng móng tay, móng chân cho khách. Có thể sơn hoặc trang trí móng. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần tìm tòi, phân tích và giải quyết vấn đề bằng tư duy.",
  "downsides": [
    "Lặp đi lặp lại cùng một động tác.",
    "Tiếp xúc với khói, bụi, hoá chất, dầu mỡ hoặc mùi khó chịu.",
    "Ngồi gần như cả ngày."
  ],
  "workFacts": [
    "Ngồi phần lớn thời gian làm việc.",
    "Ít tiếp xúc với khách hàng bên ngoài.",
    "Làm việc độc lập nhiều hơn làm theo nhóm.",
    "Ít làm việc qua email.",
    "32% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "19% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Cửa hàng, nhà hàng, khách sạn, cơ sở dịch vụ", "Văn phòng"],
