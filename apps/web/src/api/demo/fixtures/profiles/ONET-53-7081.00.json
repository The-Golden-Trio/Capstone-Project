{
  "code": "ONET-53-7081.00",
  "name": "Công nhân thu gom, xử lý rác và chất thải",
  "nameEn": "Refuse and Recyclable Material Collectors",
  "group": "Vận tải và bốc dỡ hàng hoá",
  "regionId": "dich_vu",
  "isIt": false,
  "summary": "Thu gom và đổ rác hoặc phế liệu tái chế từ thùng chứa lên xe. Có thể lái xe. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Nhiều người trong nghề làm hơn 40 giờ mỗi tuần.",
    "Làm ngoài trời, chịu mọi điều kiện thời tiết.",
    "Làm cạnh máy móc hoặc dụng cụ nguy hiểm, có nguy cơ tai nạn.",
    "Tiếp xúc với nhiệt độ rất nóng hoặc rất lạnh."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Thường ngồi trong xe hoặc cabin máy.",
    "Đứng phần lớn thời gian làm việc.",
    "Làm việc độc lập nhiều hơn làm theo nhóm.",
    "Ít làm việc qua email.",
    "60% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "33% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Trên xe, tàu, máy bay", "Hiện trường, công trường, ngoài trời"],
