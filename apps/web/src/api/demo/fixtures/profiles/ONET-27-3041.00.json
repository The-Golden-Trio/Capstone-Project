{
  "code": "ONET-27-3041.00",
  "name": "Biên tập viên",
  "nameEn": "Editors",
  "group": "Nghệ thuật, thiết kế, giải trí, thể thao và truyền thông",
  "regionId": "sang_tao",
  "isIt": false,
  "summary": "Lên kế hoạch, điều phối, sửa hoặc biên tập văn bản. Có thể xem xét đề xuất và bản thảo để cân nhắc xuất bản. Mức chuẩn bị: cần chuẩn bị nhiều. Thường cần bằng đại học.",
  "fitSummary": "Hợp với người thích làm việc theo quy trình, chính xác với số liệu và giấy tờ. Nghề cũng cần sáng tạo và tự do thể hiện ý tưởng, nhưng ít cần làm việc bằng tay với máy móc, công cụ, vật thật.",
  "downsides": [
    "Công việc lặp lại nhiều.",
    "Ngồi gần như cả ngày.",
    "Thường xuyên phải làm gấp cho kịp hạn.",
    "Lặp đi lặp lại cùng một động tác."
  ],
  "workFacts": [
    "Ngồi phần lớn thời gian làm việc.",
    "Làm việc theo nhóm là chính.",
    "Được tự quyết nhiều trong công việc.",
    "31% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "31% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Văn phòng"],
  "environments": [
    {
      "name": "Toà soạn báo, đài phát thanh truyền hình",
      "weight": 65
    },
