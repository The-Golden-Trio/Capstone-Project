{
  "code": "ONET-39-2021.00",
  "name": "Nhân viên chăm sóc thú cưng và động vật",
  "nameEn": "Animal Caretakers",
  "group": "Chăm sóc và dịch vụ cá nhân",
  "regionId": "dich_vu",
  "isIt": false,
  "summary": "Cho ăn, uống, chải lông, tắm, cho vận động hoặc chăm sóc khác cho thú cưng và động vật không nuôi để lấy thịt, như chó, mèo, ngựa đua, cá cảnh, chim, thú trong vườn thú và chuột. Làm việc tại trại chó, trạm cứu hộ, vườn thú, rạp xiếc và thuỷ cung. Có thể ghi chép việc cho ăn, chữa trị, nhận và trả động vật. Có thể dọn rửa, khử trùng và sửa chuồng, lồng hoặc bể cá. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần giúp đỡ, dạy bảo và chăm sóc người khác, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Dễ bị bỏng nhẹ, đứt tay, bị cắn hoặc đốt.",
    "Làm ngoài trời, chịu mọi điều kiện thời tiết.",
    "Phải đi lại hoặc chạy nhiều.",
    "Phải đứng trong phần lớn thời gian làm việc."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Thường ngồi trong xe hoặc cabin máy.",
    "Đứng phần lớn thời gian làm việc.",
    "19% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "20% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": [
    "Cửa hàng, nhà hàng, khách sạn, cơ sở dịch vụ",
