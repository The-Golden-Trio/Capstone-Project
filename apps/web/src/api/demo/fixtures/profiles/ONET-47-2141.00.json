{
  "code": "ONET-47-2141.00",
  "name": "Thợ sơn, thạch cao và hoàn thiện",
  "nameEn": "Painters, Construction and Maintenance",
  "group": "Xây dựng và khai khoáng",
  "regionId": "ky_thuat",
  "isIt": false,
  "summary": "Sơn tường, thiết bị, toà nhà, cầu và các bề mặt kết cấu khác bằng cọ, con lăn và súng phun. Có thể cạo sơn cũ để chuẩn bị bề mặt. Có thể pha màu hoặc dầu để có màu, độ đặc mong muốn. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần thuyết phục, dẫn dắt người khác và kinh doanh.",
  "downsides": [
    "Phải leo thang, giàn giáo hoặc cột.",
    "Phải làm việc trên cao.",
    "Hay phải quỳ, cúi, khom hoặc bò.",
    "Phải mặc đồ bảo hộ chuyên dụng như mặt nạ thở, đai an toàn hoặc đồ chống bức xạ."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Đứng phần lớn thời gian làm việc.",
    "Ít tiếp xúc với khách hàng bên ngoài.",
    "Ít làm việc qua email.",
    "13% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "46% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Hiện trường, công trường, ngoài trời"],
