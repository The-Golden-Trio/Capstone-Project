{
  "code": "ONET-47-2073.00",
  "name": "Người vận hành máy thi công",
  "nameEn": "Operating Engineers and Other Construction Equipment Operators",
  "group": "Xây dựng và khai khoáng",
  "regionId": "ky_thuat",
  "isIt": false,
  "summary": "Vận hành một hoặc nhiều loại máy thi công như máy san, máy ủi, máy cạp, máy nén khí, máy bơm, cần trục, máy xúc, máy kéo hoặc máy xúc lật để đào, chuyển và san đất, dựng công trình hoặc đổ bê tông, mặt đường. Có thể sửa chữa và bảo dưỡng máy. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Chịu rung lắc toàn thân khi vận hành máy hoặc xe.",
    "Lịch làm việc không cố định: theo ca, thay đổi hoặc theo mùa.",
    "Làm ngoài trời, chịu mọi điều kiện thời tiết.",
    "Làm cạnh máy móc hoặc dụng cụ nguy hiểm, có nguy cơ tai nạn."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Thường ngồi trong xe hoặc cabin máy.",
    "Ít được tự quyết, làm theo chỉ đạo và quy trình.",
    "Ít làm việc qua email.",
    "33% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "69% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Hiện trường, công trường, ngoài trời"],
