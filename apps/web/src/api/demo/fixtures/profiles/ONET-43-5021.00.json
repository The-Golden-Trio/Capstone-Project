{
  "code": "ONET-43-5021.00",
  "name": "Nhân viên giao hàng (shipper)",
  "nameEn": "Couriers and Messengers",
  "group": "Văn phòng và hỗ trợ hành chính",
  "regionId": "kinh_doanh",
  "isIt": false,
  "summary": "Nhận và giao thư từ, tài liệu, bưu kiện và các món khác giữa các phòng ban hoặc trực tiếp tới doanh nghiệp khác, đi bộ, xe đạp, xe máy, ô tô hoặc phương tiện công cộng. Mức chuẩn bị: cần chuẩn bị một ít. Thường cần tốt nghiệp THPT.",
  "fitSummary": "Hợp với người thích làm việc theo quy trình, chính xác với số liệu và giấy tờ. Nghề cũng cần làm việc bằng tay với máy móc, công cụ, vật thật, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Làm ngoài trời, chịu mọi điều kiện thời tiết.",
    "Lặp đi lặp lại cùng một động tác.",
    "Thường xuyên phải làm gấp cho kịp hạn.",
    "Tiếp xúc với nhiệt độ rất nóng hoặc rất lạnh."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Thường ngồi trong xe hoặc cabin máy.",
    "Làm việc độc lập nhiều hơn làm theo nhóm.",
    "Ít làm việc qua email.",
    "22% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "14% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Hiện trường, công trường, ngoài trời"],
