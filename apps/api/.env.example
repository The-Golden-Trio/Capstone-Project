NODE_ENV=
PORT=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=
# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=
# Bi mat ky JWT — sinh bang: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Goc cua web app, dung cho CORS khi chay that (luc dev da co proxy Vite)
WEB_ORIGIN=

# Claude cho Get to Know Me (doc cau tu luan, viet doan mo ta). De trong thi
# dung khuon co dinh va de cau tu luan cho doc sau.
ANTHROPIC_API_KEY=
# Mac dinh claude-opus-5. Muon re hon thi dat claude-haiku-4-5 hoac claude-sonnet-5
PORTRAIT_MODEL=
