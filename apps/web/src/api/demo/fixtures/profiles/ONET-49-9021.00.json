{
  "code": "ONET-49-9021.00",
  "name": "Thợ điện lạnh",
  "nameEn": "Heating, Air Conditioning, and Refrigeration Mechanics and Installers",
  "group": "Lắp đặt, bảo trì và sửa chữa",
  "regionId": "ky_thuat",
  "isIt": false,
  "summary": "Lắp đặt hoặc sửa chữa hệ thống sưởi, điều hoà trung tâm, thông gió hoặc làm lạnh, gồm cả lò đốt dầu, lò khí nóng và bếp sưởi. Mức chuẩn bị: cần chuẩn bị ở mức vừa. Thường cần học nghề, cao đẳng hoặc chứng chỉ chuyên môn.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần làm việc theo quy trình, chính xác với số liệu và giấy tờ, nhưng ít cần sáng tạo và tự do thể hiện ý tưởng.",
  "downsides": [
    "Làm trong nhà nhưng không có kiểm soát nhiệt độ hay thông gió.",
    "Làm trong không gian chật hoặc tư thế khó.",
    "Dễ bị bỏng nhẹ, đứt tay, bị cắn hoặc đốt.",
    "Tiếp xúc với khói, bụi, hoá chất, dầu mỡ hoặc mùi khó chịu."
  ],
  "workFacts": [
    "Thường làm ngoài trời, chịu thời tiết.",
    "Thường ngồi trong xe hoặc cabin máy.",
    "Được tự quyết nhiều trong công việc.",
    "24% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "16% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
  "settings": ["Hiện trường, công trường, ngoài trời"],
  "environments": [
