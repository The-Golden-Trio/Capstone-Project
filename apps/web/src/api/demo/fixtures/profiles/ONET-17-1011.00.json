{
  "code": "ONET-17-1011.00",
  "name": "Kiến trúc sư",
  "nameEn": "Architects, Except Landscape and Naval",
  "group": "Kiến trúc và kỹ thuật",
  "regionId": "ky_thuat",
  "isIt": false,
  "summary": "Lập phương án và thiết kế công trình như nhà ở, toà văn phòng, nhà hát, nhà xưởng và các công trình khác. Mức chuẩn bị: cần chuẩn bị rất nhiều. Thường cần bằng sau đại học, như thạc sĩ, tiến sĩ hoặc bằng chuyên ngành y, luật.",
  "fitSummary": "Hợp với người thích làm việc bằng tay với máy móc, công cụ, vật thật. Nghề cũng cần sáng tạo và tự do thể hiện ý tưởng, nhưng ít cần giúp đỡ, dạy bảo và chăm sóc người khác.",
  "downsides": [
    "Nhiều người trong nghề làm hơn 40 giờ mỗi tuần.",
    "Ngồi gần như cả ngày.",
    "Môi trường cạnh tranh cao."
  ],
  "workFacts": [
    "Phần lớn thời gian làm trong nhà, có điều hoà.",
    "Ngồi phần lớn thời gian làm việc.",
    "Làm việc theo nhóm là chính.",
    "Ít được tự quyết, làm theo chỉ đạo và quy trình.",
    "61% người trong nghề làm hơn 40 giờ mỗi tuần.",
    "16% người trong nghề có lịch làm thay đổi hoặc theo mùa; còn lại làm giờ cố định."
  ],
