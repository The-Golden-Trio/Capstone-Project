@startuml CL-02_CatalogueAndImport
hide empty members
skinparam classAttributeIconSize 0
left to right direction

package "CatalogueModule" <<Rectangle>> {
  class CatalogueModule <<module>> {
    imports: AuthModule
    controllers: CatalogueController, OccupationController
    providers: CatalogueService, OccupationService, OccupationDataLoader
    exports: CatalogueService
  }
  class CatalogueController <<controller>> {
    -catalogue : CatalogueService
    --
    +getGalaxyMap(user: AuthUser) : GalaxyMap  «GET /occupations» [EX]
    +getOccupation(user: AuthUser, occupationId: string) : OccupationView  «GET /occupations/{occupationId}» [EX]
    +getLevel(user: AuthUser, levelId: string) : LevelView  «GET /levels/{levelId}» [EX]
  }
  class OccupationController <<controller>> {
    -occupations : OccupationService
    --
    +listMyOccupations(user: AuthUser) : StaffOccupation[]  «GET /staff/occupations» [CA,DE]
    +updateOccupation(user: AuthUser, occupationId: string, dto: OccupationUpdateInput) : StaffOccupation  «PATCH /staff/occupations/{occupationId}» [CA,DE]
    +getLevelPackage(user: AuthUser, levelId: string) : LevelPackage  «GET /staff/levels/{levelId}» [CA,DE]
  }
  class CatalogueService {
    -prisma : PrismaService
    -data : GameData
    --
    +galaxyMap(user) : GalaxyMap
    +occupation(user, id) : OccupationView
    +level(user, id) : LevelView
  }
  class OccupationService {
    -prisma : PrismaService
    -audit : AuditLogService
    --
    +listAssigned(user) : StaffOccupation[]
    +update(user, id, dto) : StaffOccupation  «CA: status; DE: profile»
    +levelPackage(levelId) : LevelPackage
  }
  class OccupationDataLoader <<command>> {
    <i>CLI: loads occupation-data (221 occupations, levels, budgets, soft skills, work environments, 22 NPC, outfits) into the catalogue tables; O*NET and ESCO sources go through ImportModule</i>
    -prisma : PrismaService
    -storage : StorageService
    --
    +run(path) : LoadReport
    -upsertOccupation(json) : void
    -upsertLevels(json) : void
    -upsertNpcs(yaml) : void
  }
  class "CatalogueModule DTOs" as CatalogueModule_DTOs <<dto>> {
    OccupationUpdateInput { status?, profile? }
    GalaxyMap
    LevelPackage
    LevelView
    OccupationView
    StaffOccupation
  }
}

package "ImportModule" <<Rectangle>> {
  class ImportModule <<module>> {
    imports: AuthModule
    controllers: ImportController
    providers: ImportService, ImportProcessor, ReferenceSourceClient
    exports: —
    <i>reference data import: O*NET and ESCO files → matching → record fixes → Vietnamese keyword names (SD-09)</i>
  }
  class ImportController <<controller>> {
    -imports : ImportService
    --
    +startImport(user: AuthUser, dto: StartImportInput) : ImportView  «POST /staff/imports» [CA]
    +getImport(user: AuthUser, importId: string) : ImportView  «GET /staff/imports/{importId}» [CA]
    +resolveIssue(user: AuthUser, importId: string, issueId: string, dto: ResolveIssueInput) : ImportView  «PUT /staff/imports/{importId}/issues/{issueId}» [CA]
    +saveAdaptation(user: AuthUser, importId: string, dto: AdaptInput) : ImportView  «PUT /staff/imports/{importId}/adaptation» [CA]
  }
  class ImportService {
    -prisma : PrismaService
    -storage : StorageService
    -importQueue : Queue «import»
    --
    +start(user, dto) : ImportView  «file already in object storage; enqueues the job»
    +get(id) : ImportView
    +resolve(user, importId, issueId, dto) : ImportView  «RESOLVES: issue closed by a staff member»
    +saveAdaptation(user, importId, dto) : ImportView  «Vietnamese keyword names, nameViStatus»
  }
  class ImportProcessor <<processor · import>> {
    -prisma : PrismaService
    -source : ReferenceSourceClient
    -stream : StreamService
    --
    +process(job) : Promise<void>  «match records to sources; unmatched ones become IMPORT_ISSUE rows; publishes import.done»
  }
  class ReferenceSourceClient <<adapter>> {
    <i>looks up source identifiers (SOC code, ESCO URI) at O*NET and ESCO</i>
    -http : HttpService
    --
    +lookup(source, ref) : SourceRecord | null
  }
  class "ImportModule DTOs" as ImportModule_DTOs <<dto>> {
    AdaptInput { keywords[] {escoUri, nameVi} }
    ResolveIssueInput { resolution: MAP|SKIP, targetRef? }
    StartImportInput { source: ONET|ESCO, version, fileKey }
    ImportView
  }
}

